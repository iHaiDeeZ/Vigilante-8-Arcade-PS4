+
+namespace {
+std::atomic<int> cp_core_cycle_index{0};
+
+// The cores in gpu_commands_core_cycle (0-6), at most 8.
+int ParseCoreCycle(int* cores) {
+  const std::string& text = REXCVAR_GET(gpu_commands_core_cycle);
+  int count = 0;
+  for (size_t i = 0; i < text.size() && count < 8; ++i) {
+    if (text[i] >= '0' && text[i] <= '6') {
+      cores[count++] = text[i] - '0';
+    }
+  }
+  return count;
+}
+}  // namespace
+
+bool CommandProcessorCoreCycling() {
+  int cores[8];
+  return ParseCoreCycle(cores) > 1;
+}
+
+void AdvanceCommandProcessorCoreCycle() { cp_core_cycle_index.fetch_add(1, std::memory_order_relaxed); }
+
 int CommandProcessorCore() {
+  {
+    int cores[8];
+    const int count = ParseCoreCycle(cores);
+    if (count > 0) {
