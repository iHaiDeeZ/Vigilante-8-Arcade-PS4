diff --git a/project/ps4/vig8_ps4.cpp b/project/ps4/vig8_ps4.cpp
new file mode 100644
index 0000000..9b49923
--- /dev/null
+++ b/project/ps4/vig8_ps4.cpp
@@ -0,0 +1,247 @@
+// vig8-ps4 - Vigilante 8 Arcade on the PS4: the port's settings for ps4-kit's runtime and the SDK, and its
+// diagnostics.
+//
+// /data/V8A is the app's folder: vig8.toml (written on the first start), the logs, the saves, the kit's boot trace
+// and crash log, hang.log (the freeze report). The SDK's executable and user folders point here
+// (sdk/src/core/filesystem_posix.cpp), because /app0 is read-only.
+
+#include "vig8_pch.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <filesystem>
+#include <string>
+#include <system_error>
+#include <thread>
+
+#include <ps4_kit.h>
+#include <ps4_kit_diag.h>
+
+#include <rex/cvar.h>
+#include <rex/kernel/xboxkrnl/video.h>
+#include <rex/logging.h>
+#include <rex/runtime.h>
+
+#include "vig8_ps4.h"
+#include "vig8_ps4_achievements.h"
+#include "vig8_ps4_menu.h"
+
+#include <rex/kernel/xam/ui_hooks.h>
+
+PS4_DIAG_DATA_DIR("/data/V8A");
+
+// v00.11: the main heap from direct memory. By default it took 256 MiB of the system flexible pool (391 MiB here),
+// which the kernel's pthread objects (every std::mutex and condition variable: each guest event, semaphore and
+// thread has some), the system libc heap and Sony's modules share. v00.10 ran out of it 20 minutes into a race:
+// a new event's mutex could not get its kernel object ("mutex lock failed: Out of memory", XamUserWriteProfileSettings
+// completing). Direct memory has room (3.4 GB free after the guest arena); the heap's overflow already went there.
+extern "C" void ps4_kit_configure_heap(ps4_kit_heap_options* options) {
+  options->log_tag = "vig8";
+  options->source_order = PS4_KIT_HEAP_DIRECT_FIRST;
+}
+
+// libkernel: the flexible memory still free (the kit's start line "heap: flexible memory available").
+extern "C" int32_t sceKernelAvailableFlexibleMemorySize(size_t* size);
+// The SDK (system/xobject.cpp, v00.11): live guest objects by type.
+extern "C" uint32_t rex_xobject_live_counts(uint32_t* out, uint32_t count);
+
+REXCVAR_DEFINE_STRING(vig8_game, "", "Vig8",
+                      "Game folder (the unpacked XBLA package: default.xex, data/ ...). Empty: game/ in the package, "
+                      "then /data/V8A/game");
+REXCVAR_DEFINE_BOOL(vig8_occlusion_queries, false, "Vig8",
+                    "GPU occlusion queries answered by the GPU (the command processor waits for it at each one). "
+                    "false: every query reports its object visible");
+// v00.09: a test - the GPU command processor alternates between core 6 (the other CPU module, as before) and core 2
+// (the game thread's module), one 10 s stats period each; the log's [cp2] lines name each period's core. v00.09 on
+// a PS4 Pro: the same cost a draw on both (2,500 draws: 28.5 ms either way), so core 6 again by default (v00.10).
+REXCVAR_DEFINE_BOOL(vig8_cp_core_test, false, "Vig8",
+                    "Test: the GPU command processor alternates between cores 6 and 2 every 10 s (the log tells "
+                    "which is faster). false: core 6 only");
+// v00.10: the 3D scene's anti-aliasing (vig8_ps4_game.cpp, project/tools/patch_game_fixes.py). The original's 4x MSAA
+// does not fit the 360's EDRAM at 720p, so the game draws the scene in 4 tiles and the GPU emulation translates every
+// draw 4 times; with one sample the scene is drawn once.
+REXCVAR_DEFINE_INT32(vig8_antialiasing, 0, "Vig8",
+                     "The 3D scene's anti-aliasing: 0 = FXAA on the picture (the scene drawn once), 1 = none (the "
+                     "scene drawn once), 2 = the original 4x MSAA (the scene drawn in 4 tiles: every draw 4 times, "
+                     "far slower). Live");
+REXCVAR_DEFINE_BOOL(vig8_msr_global_lock, false, "Vig8",
+                    "The recompiled code's interrupts-off regions (mtmsrd) as one process-wide mutex, as the codegen "
+                    "makes them. false: per-thread state (the atomics inside are host compare-and-swaps already)");
+REXCVAR_DEFINE_BOOL(vig8_freeze_report, true, "Vig8",
+                    "Diagnostic: when the game shows no new frame for 15 s, the stacks of every thread to "
+                    "/data/V8A/hang.log (again 30 s later)");
+REXCVAR_DEFINE_BOOL(vig8_frame_log, true, "Vig8", "A line in the log every 10 s with the game's frames per second");
+REXCVAR_DEFINE_BOOL(vig8_memory_log, true, "Vig8",
+                    "Diagnostic: a [memory] line in the log every 10 s - the free flexible memory (the pool the "
+                    "kernel's pthread objects come from), the heap, and the live guest objects by type");
+REXCVAR_DEFINE_STRING(vig8_radv_debug, "", "Vig8",
+                      "RADV_DEBUG for the GPU driver (RADV's comma-separated debug options; empty: none). v00.02 "
+                      "ran with nofmask,nohiz,nofastclears and the system killed it at the same point as v00.01 (a "
+                      "GPU page fault at the first gameplay frame), so they are not the cause");
+REXCVAR_DEFINE_BOOL(vig8_gpu_trace, false, "Vig8",
+                    "Diagnostic: the GPU driver's flight recorder (RADV_PS4_TRACE): each submission's commands, "
+                    "the memory they point to, every shader's code and the last draw the GPU reached, in "
+                    "/data/Crema/gpu/flight (where the kit's RADV writes), which survive the app being killed by a "
+                    "GPU fault. It found v00.01-v00.03's crash (the tessellation factor ring); it costs speed");
+
+namespace vig8::ps4 {
+
+namespace {
+
+std::atomic<uint32_t> g_swaps{0};
+
+uint64_t NowNs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+
+// Each setting only while it still has the SDK's value: vig8.toml and the command line win.
+void SetDefault(const char* name, const char* value) {
+  if (!rex::cvar::HasNonDefaultValue(name)) rex::cvar::SetFlagByName(name, value);
+}
+
+// At each VdSwap, on the game's thread.
+void OnGuestSwap() {
+  vig8::menu::NoteSwap();  // the quick menu's frame counter and its L3+R3
+  const uint32_t n = g_swaps.fetch_add(1, std::memory_order_acq_rel) + 1;
+  if (!REXCVAR_GET(vig8_frame_log)) return;
+  static uint64_t window_start = 0;
+  static uint32_t window_swaps = 0;
+  const uint64_t now = NowNs();
+  if (!window_start) {
+    window_start = now;
+    window_swaps = n;
+    REXLOG_INFO("[frames] first frame presented");
+    return;
+  }
+  if (now - window_start >= 10'000'000'000ull) {
+    const double seconds = double(now - window_start) / 1e9;
+    REXLOG_INFO("[frames] {:.1f} fps over the last {:.0f} s ({} frames so far)", double(n - window_swaps) / seconds,
+                seconds, n);
+    window_start = now;
+    window_swaps = n;
+  }
+}
+
+// When the game has shown no new frame for 15 s (after at least 60): every thread's stack (ps4-kit's thread dump: host
+// return addresses relative to .text, for llvm-symbolizer --obj=<the build's ELF in ~/vig8-build/oelf>; recompiled
+// guest functions are named sub_XXXXXXXX there) to /data/V8A/hang.log, and once more 30 s later. MP3's freeze report.
+// v00.11: every 10 s (from the freeze watch's thread), what v00.10's "Out of memory" crash would have shown coming:
+// the free flexible memory and its change since the start, the heap, the live guest objects by type.
+void LogMemory() {
+  static size_t first_free = 0;
+  size_t free_bytes = 0;
+  sceKernelAvailableFlexibleMemorySize(&free_bytes);
+  if (!first_free) first_free = free_bytes;
+  char heap[192] = {};
+  ps4rt_heap_report(heap, sizeof(heap));
+  uint32_t live[16] = {};
+  const uint32_t total = rex_xobject_live_counts(live, 16);
+  // XObject::Type: 2 event, 3 file, 4 I/O completion, 6 mutant, 7 notify listener, 8 semaphore, 12 thread, 13 timer.
+  const uint32_t other = total - live[2] - live[3] - live[6] - live[7] - live[8] - live[12] - live[13];
+  REXLOG_INFO("[memory] flexible memory free {:.1f} MiB ({:+.1f} MiB since the start); {}; guest objects {}: events "
+              "{}, semaphores {}, mutants {}, timers {}, threads {}, files {}, notify listeners {}, other {}",
+              double(free_bytes) / 1048576.0, (double(free_bytes) - double(first_free)) / 1048576.0, heap, total,
+              live[2], live[8], live[6], live[13], live[12], live[3], live[7], other);
+}
+
+void StartFreezeReport() {
+  std::thread([] {
+    ps4_watch_thread("vig8 freeze watch");
+    const std::string path = std::string(ps4_diag_data_dir()) + "/hang.log";
+    uint32_t last = g_swaps.load(std::memory_order_acquire);
+    auto last_change = std::chrono::steady_clock::now();
+    int dumps = 0;
+    int memory_ticks = 0;
+    for (;;) {
+      std::this_thread::sleep_for(std::chrono::seconds(1));
+      if (++memory_ticks >= 10) {
+        memory_ticks = 0;
+        if (REXCVAR_GET(vig8_memory_log)) LogMemory();
+      }
+      const uint32_t now_count = g_swaps.load(std::memory_order_acquire);
+      const auto now = std::chrono::steady_clock::now();
+      const double stalled = std::chrono::duration<double>(now - last_change).count();
+      if (now_count != last) {
+        if (dumps) REXLOG_WARN("[freeze] frames again after {:.0f} s ({} thread dumps in {})", stalled, dumps, path);
+        last = now_count;
+        last_change = now;
+        dumps = 0;
+        continue;
+      }
+      if (now_count < 60 || !REXCVAR_GET(vig8_freeze_report)) continue;
+      if ((dumps == 0 && stalled >= 15.0) || (dumps == 1 && stalled >= 45.0)) {
+        ++dumps;
+        const std::string reason = "vig8 freeze report " + std::to_string(dumps) + ": no new frame for " +
+                                   std::to_string(int(stalled)) + " s after " + std::to_string(now_count) + " frames";
+        REXLOG_WARN("[freeze] no new frame for {:.0f} s: the stacks of every thread to {}", stalled, path);
+        rex::FlushLogging();
+        ps4_dump_thread_stacks(path.c_str(), reason.c_str());
+        REXLOG_WARN("[freeze] thread dump {} written", dumps);
+        rex::FlushLogging();
+      }
+    }
+  }).detach();
+}
+
+}  // namespace
+
+void ApplyDefaults() {
+  // The full game rather than the XBLA trial (sp00nznet/vig8's default too).
+  SetDefault("license_mask", "4294967295");
+  // Textures whose fetch constants Xenia calls invalid (type bits 00) are real ones in the 360 games seen so far
+  // (MP3 v00.08's black world); Xenia binds them with this.
+  SetDefault("gpu_allow_invalid_fetch_constants", "true");
+  // Occlusion queries: the SDK's Vulkan command processor ends its submission and waits for the GPU at each one
+  // (MP3 v00.04: the command processor and the GPU took turns). Off unless vig8_occlusion_queries.
+  rex::cvar::SetFlagByName("occlusion_query_enable", REXCVAR_GET(vig8_occlusion_queries) ? "true" : "false");
+  // v00.09: the command processor core test (vig8_cp_core_test, SDK gpu_commands_core_cycle).
+  rex::cvar::SetFlagByName("gpu_commands_core_cycle", REXCVAR_GET(vig8_cp_core_test) ? "6,2" : "");
+  // v00.10: FXAA with vig8_antialiasing 0 (the SDK reads swap_post_effect as the graphics system starts; the quick menu
+  // changes it live through rex_gpu_set_swap_post_effect).
+  rex::cvar::SetFlagByName("swap_post_effect", REXCVAR_GET(vig8_antialiasing) == 0 ? "fxaa" : "none");
+  // The DLC (High Octane Pack) in the package, in the installed-content layout (scripts/dlc-layout.py).
+  std::error_code ec;
+  if (std::filesystem::is_directory("/app0/content", ec)) SetDefault("content_marketplace_root", "/app0/content");
+}
+
+void LogSystem() {
+  const unsigned mhz = ps4_kit_cpu_mhz();
+  REXLOG_INFO("vig8-ps4 {} (commit {}); the CPU cores run at {} MHz ({})", VIG8_VERSION, VIG8_COMMIT, mhz,
+              vig8::menu::ConsoleText());
+  // The GPU driver reads these when the SDK creates its Vulkan instance and device, which comes after this (and after
+  // vig8.toml is read).
+  const std::string radv_debug = REXCVAR_GET(vig8_radv_debug);
+  if (!radv_debug.empty()) setenv("RADV_DEBUG", radv_debug.c_str(), 1);
+  if (REXCVAR_GET(vig8_gpu_trace)) setenv("RADV_PS4_TRACE", "1", 1);
+  REXLOG_INFO("[gpu] driver options: RADV_DEBUG={}; flight recorder {}", radv_debug.empty() ? "(none)" : radv_debug,
+              REXCVAR_GET(vig8_gpu_trace) ? "on (/data/Crema/gpu/flight)" : "off");
+}
+
+void Install(rex::Runtime& runtime) {
+  ppc_msr_cerrojo_global_() = REXCVAR_GET(vig8_msr_global_lock);
+  REXLOG_INFO("[cpu] interrupts-off regions: {}",
+              ppc_msr_cerrojo_global_() ? "one process-wide mutex (codegen)" : "per-thread state");
+  REXLOG_INFO("[gpu] anti-aliasing: {}", REXCVAR_GET(vig8_antialiasing) == 2   ? "4x MSAA (the original: 4 tiles)"
+                                         : REXCVAR_GET(vig8_antialiasing) == 1 ? "none (the scene in one pass)"
+                                                                               : "FXAA (the scene in one pass)");
+  REXLOG_INFO("[gpu] occlusion queries {}; DLC from {}",
+              REXCVAR_GET(vig8_occlusion_queries) ? "on (waits for the GPU)" : "off (reported visible)",
+              rex::cvar::GetFlagByName("content_marketplace_root").empty()
+                  ? std::string("the content root")
+                  : rex::cvar::GetFlagByName("content_marketplace_root"));
+  rex::kernel::xboxkrnl::SetGuestSwapHook(&OnGuestSwap);
+  StartFreezeReport();
+  // The game's achievements: the menu's tab and pop-ups; its own "Achievements" item opens that tab.
+  vig8::achievements::Install(runtime);
+  rex::kernel::xam::SetShowAchievementsUiHook(&vig8::menu::ShowAchievementsList);
+}
+
+unsigned SwapCount() {
+  return g_swaps.load(std::memory_order_acquire);
+}
+
+}  // namespace vig8::ps4
diff --git a/project/ps4/vig8_ps4.h b/project/ps4/vig8_ps4.h
new file mode 100644
index 0000000..27b5a34
--- /dev/null
+++ b/project/ps4/vig8_ps4.h
@@ -0,0 +1,30 @@
+// vig8-ps4 - the port's settings, defaults and diagnostics (vig8_ps4.cpp).
+
+#pragma once
+
+#include <string>
+
+#include <rex/cvar.h>
+
+namespace rex {
+class Runtime;
+}
+
+REXCVAR_DECLARE(std::string, vig8_game);
+
+namespace vig8::ps4 {
+
+// OnPreSetup: the port's defaults for SDK settings (full-game license, GPU settings, where the DLC is).
+void ApplyDefaults();
+
+// OnPostInitLogging: version, commit, CPU clock; the GPU driver's options (vig8_radv_debug, vig8_gpu_trace), set
+// before the SDK starts the GPU.
+void LogSystem();
+
+// OnPreLaunchModule: the interrupt-lock mode, the frame counter (a line every 10 s) and the freeze report.
+void Install(rex::Runtime& runtime);
+
+// Frames the game has presented (VdSwap calls).
+unsigned SwapCount();
+
+}  // namespace vig8::ps4
diff --git a/project/ps4/vig8_ps4_achievements.cpp b/project/ps4/vig8_ps4_achievements.cpp
new file mode 100644
index 0000000..802ff3d
--- /dev/null
+++ b/project/ps4/vig8_ps4_achievements.cpp
@@ -0,0 +1,92 @@
+// vig8-ps4 - the game's own Xbox 360 achievements, kept on the console and shown the port's way, as in MP3-PS4
+// (v00.06). MP3-PS4's mp3_ps4_achievements.cpp.
+//
+// The SDK does the bookkeeping: the game's achievement write (XGIUserWriteAchievements) reaches
+// KernelState::UnlockAchievement, whose AchievementManager holds the catalog read from the executable's XDBF resource
+// (names, descriptions, gamerscore, flags) and saves the unlocks to <user data>/achievements/<title>.toml. Here: a
+// notification listener that hands each new unlock to the quick menu's pop-up (vig8_ps4_menu.cpp), the SDK's own
+// notification turned off (logros_aviso_en_pantalla) so there is one, and the list the menu's ACHIEVEMENTS tab shows.
+// Every unlock is logged ("[achievements] unlocked"), and the catalog's size at start.
+
+#include "vig8_ps4_achievements.h"
+
+#include "vig8_ps4_menu.h"
+
+#include <ctime>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/runtime.h>
+#include <rex/system/achievement_manager.h>
+#include <rex/system/kernel_state.h>
+
+REXCVAR_DEFINE_BOOL(vig8_achievement_popups, true, "Vig8",
+                    "A pop-up when the game unlocks one of its achievements (the quick menu's style). Live");
+
+namespace vig8::achievements {
+namespace {
+
+rex::system::KernelState* g_kernel = nullptr;
+bool g_listening = false;
+
+// XDBF achievement flags: shown in the list before it is earned.
+constexpr uint32_t kShowUnachieved = 0x8;
+
+}  // namespace
+
+void Install(rex::Runtime& runtime) {
+  g_kernel = runtime.kernel_state();
+  if (!g_kernel || g_listening) return;
+  g_listening = true;
+  rex::cvar::SetFlagByName("logros_aviso_en_pantalla", "false");  // the menu's pop-up instead
+  auto& manager = g_kernel->achievements();
+  manager.RegisterNotificationCallback([](const rex::system::AchievementEvent& event) {
+    REXLOG_INFO("[achievements] unlocked {:08X} \"{}\" ({} G)", event.achievement.id, event.achievement.label,
+                event.achievement.gamerscore);
+    if (REXCVAR_GET(vig8_achievement_popups))
+      vig8::menu::ShowAchievement(event.achievement.label, event.achievement.gamerscore);
+  });
+  const auto list = List();
+  uint32_t unlocked = 0, score = 0, total = 0;
+  for (const Entry& e : list) {
+    total += e.gamerscore;
+    if (e.unlocked) {
+      ++unlocked;
+      score += e.gamerscore;
+    }
+  }
+  REXLOG_INFO("[achievements] {} in the game's catalog, {} unlocked ({} of {} G)", list.size(), unlocked, score,
+              total);
+}
+
+std::vector<Entry> List() {
+  std::vector<Entry> out;
+  if (!g_kernel) return out;
+  const auto& manager = g_kernel->achievements();
+  for (const auto& info : manager.ListAchievements()) {
+    Entry e;
+    e.id = info.id;
+    e.name = info.label;
+    e.description = info.description;
+    e.locked_description = info.unachieved_description;
+    e.gamerscore = info.gamerscore;
+    e.secret = !(info.flags & kShowUnachieved);
+    e.unlocked = manager.IsUnlocked(info.id);
+    e.filetime = e.unlocked ? manager.GetUnlockTime(info.id) : 0;
+    out.push_back(std::move(e));
+  }
+  return out;
+}
+
+std::string DateText(uint64_t filetime) {
+  if (!filetime) return "";
+  const int64_t unix_seconds = int64_t(filetime / 10000000ull) - 11644473600ll;
+  const std::time_t t = std::time_t(unix_seconds);
+  std::tm tm{};
+  gmtime_r(&t, &tm);
+  char text[16];
+  std::strftime(text, sizeof(text), "%Y-%m-%d", &tm);
+  return text;
+}
+
+}  // namespace vig8::achievements
