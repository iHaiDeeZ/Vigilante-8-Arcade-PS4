diff --git a/project/tools/make_ps4_pch.py b/project/tools/make_ps4_pch.py
new file mode 100644
index 0000000..ed5d6f9
--- /dev/null
+++ b/project/tools/make_ps4_pch.py
@@ -0,0 +1,156 @@
+#!/usr/bin/env python3
+"""Make the PS4 PCH for Vigilante 8's generated code (project/ps4/CMakeLists.txt, through prepare_tree.py).
+
+generated/default/vig8_pch.h is rendered by the host code generator (ReXGlue v0.10.0). The PS4 build compiles it
+against MP3's PS4 SDK, and needs, as MP3's port does (mp3-nx tools/make_nx_pch.py + make_ps4_pch.py, merged here):
+
+  1. The interrupt locks per thread (make_nx_pch.py point 3). Guest code brackets its lwarx/stwcx. sequences with
+     mtmsrd (interrupts off); the codegen makes each region one process-wide recursive mutex. The atomic inside is
+     already a host compare-and-swap, so the "interrupts off" state is per thread (what mfmsr reads back);
+     ppc_msr_cerrojo_global_() brings the old global mutex back (cvar vig8_msr_global_lock).
+  2. REX_RAW_ADDR_W, in case a pass writes it.
+  3. Guest stack accesses without volatile: REX_SLOAD_* / REX_SSTORE_* (tools/patch_stack_access.py).
+  4. REX_PHYS_HOST_OFFSET for the PS4: the 0xE0000000 heap sits 4 KiB further in host memory there (64 KiB
+     allocation granularity, as on Windows; sdk/src/core/memory_ps4.cpp). v0.10.0's template gives the offset only to
+     Windows and arm64 macOS: without it every access to that heap reads the wrong page (the MGR port's v00.03 crash).
+  5. REX_VMADDFP / REX_VNMSUBFP (tools/patch_vmx_exact.py) and REX_FMA (tools/ps4_unfused_fma.py) as a multiply and
+     an add: the Jaguar has no FMA unit, so a fused form would be libm's software fma.
+  6. REX_LOAD_U32_B(base_register, displacement) ..., for MP3's patch_phys_base.py, should it be used.
+  7. An include guard around everything (cmake_pch.hxx includes the header again after the PCH).
+
+Usage: make_ps4_pch.py <generated/default/vig8_pch.h> <out.h>
+"""
+import sys
+
+src, dst = sys.argv[1], sys.argv[2]
+text = open(src, encoding="utf-8").read()
+GUARD = "VIG8_PS4_PCH_H"
+
+# 1. The interrupt locks.
+OLD_LOCKS_START = "#define REX_CHECK_GLOBAL_LOCK()"
+OLD_LOCKS_END = "rex::thread::global_critical_region::mutex().unlock();                                \\\n  } while (0)\n"
+i = text.find(OLD_LOCKS_START)
+j = text.find(OLD_LOCKS_END, i)
+if i < 0 or j < 0 or text.count(OLD_LOCKS_START) != 1:
+    sys.exit("interrupt lock macros not found exactly once")
+j += len(OLD_LOCKS_END)
+NEW_LOCKS = """// PS4 (make_ps4_pch.py, 1): the interrupt locks per thread unless ppc_msr_cerrojo_global_().
+inline bool& ppc_msr_cerrojo_global_() {
+  static bool global = false;
+  return global;
+}
+
+inline i32& ppc_msr_profundidad_() {
+  static thread_local i32 profundidad = 0;
+  return profundidad;
+}
+
+#define REX_CHECK_GLOBAL_LOCK()                                          \\
+  (ppc_msr_cerrojo_global_() ? ([&]() -> u64 {                           \\
+    auto lock_ = rex::thread::global_critical_region::AcquireDirect();   \\
+    return ppc_global_lock_count_().load() ? 0 : 0x8000;                 \\
+  }())                                                                   \\
+                             : (ppc_msr_profundidad_() ? u64(0) : u64(0x8000)))
+
+#define REX_ENTER_GLOBAL_LOCK()                              \\
+  do {                                                       \\
+    if (ppc_msr_cerrojo_global_()) {                         \\
+      rex::thread::global_critical_region::mutex().lock();   \\
+      ppc_global_lock_count_().fetch_add(1);                 \\
+    } else {                                                 \\
+      ++ppc_msr_profundidad_();                              \\
+    }                                                        \\
+  } while (0)
+
+#define REX_LEAVE_GLOBAL_LOCK()                              \\
+  do {                                                       \\
+    if (ppc_msr_cerrojo_global_()) {                         \\
+      ppc_global_lock_count_().fetch_sub(1);                 \\
+      rex::thread::global_critical_region::mutex().unlock(); \\
+    } else {                                                 \\
+      --ppc_msr_profundidad_();                              \\
+    }                                                        \\
+  } while (0)
+"""
+text = text[:i] + NEW_LOCKS + text[j:]
+
+# 2. REX_RAW_ADDR_W.
+if "REX_RAW_ADDR_W" not in text:
+    text = text.rstrip() + """
+
+// PS4 (make_ps4_pch.py, 2): stores written as REX_RAW_ADDR_W by some passes.
+#ifndef REX_RAW_ADDR_W
+#define REX_RAW_ADDR_W(x, n) REX_RAW_ADDR(x)
+#endif
+"""
+
+# 3. Guest stack accesses (r1), without volatile.
+if "REX_SLOAD_U32" not in text:
+    text = text.rstrip() + """
+
+// PS4 (make_ps4_pch.py, 3): guest stack accesses (r1), without volatile.
+#define REX_SLOAD_U8(x) ({ u8 rex_sv_; __builtin_memcpy(&rex_sv_, base + (u32)(x), 1); rex_sv_; })
+#define REX_SLOAD_U16(x) ({ u16 rex_sv_; __builtin_memcpy(&rex_sv_, base + (u32)(x), 2); __builtin_bswap16(rex_sv_); })
+#define REX_SLOAD_U32(x) ({ u32 rex_sv_; __builtin_memcpy(&rex_sv_, base + (u32)(x), 4); __builtin_bswap32(rex_sv_); })
+#define REX_SLOAD_U64(x) ({ u64 rex_sv_; __builtin_memcpy(&rex_sv_, base + (u32)(x), 8); __builtin_bswap64(rex_sv_); })
+#define REX_SSTORE_U8(x, y) ({ u8 rex_sv_ = (u8)(y); __builtin_memcpy(base + (u32)(x), &rex_sv_, 1); })
+#define REX_SSTORE_U16(x, y) ({ u16 rex_sv_ = __builtin_bswap16(y); __builtin_memcpy(base + (u32)(x), &rex_sv_, 2); })
+#define REX_SSTORE_U32(x, y) ({ u32 rex_sv_ = __builtin_bswap32(y); __builtin_memcpy(base + (u32)(x), &rex_sv_, 4); })
+#define REX_SSTORE_U64(x, y) ({ u64 rex_sv_ = __builtin_bswap64(y); __builtin_memcpy(base + (u32)(x), &rex_sv_, 8); })
+"""
+
+# 4. The physical heap's host offset.
+OFFSET = "#if REX_PLATFORM_WIN32 || (REX_PLATFORM_MAC && REX_ARCH_ARM64)\n#define REX_PHYS_HOST_OFFSET"
+if text.count(OFFSET) != 1:
+    sys.exit("REX_PHYS_HOST_OFFSET condition not found exactly once")
+text = text.replace(OFFSET, "#if REX_PLATFORM_WIN32 || REX_PLATFORM_PS4 || (REX_PLATFORM_MAC && REX_ARCH_ARM64)\n"
+                            "#define REX_PHYS_HOST_OFFSET")
+
+# 5. vmaddfp / vnmsubfp and the fmadd family unfused.
+if "REX_VMADDFP" not in text:
+    text = text.rstrip() + """
+
+// PS4 (make_ps4_pch.py, 5): the Jaguar has no FMA unit, so a multiply and an add (one rounding more than the console).
+#include <simde/x86/sse.h>
+#define REX_VMADDFP(a, b, c) simde_mm_add_ps(simde_mm_mul_ps((a), (b)), (c))
+#define REX_VNMSUBFP(a, b, c) simde_mm_sub_ps((c), simde_mm_mul_ps((a), (b)))
+#if defined(__FMA__)
+#define REX_FMA(a, b, c) std::fma((a), (b), (c))
+#else
+#define REX_FMA(a, b, c) ((a) * (b) + (c))
+#endif
+"""
+
+# 6. Register + displacement accesses with the heap offset from the base register.
+if "REX_LOAD_U32_B" not in text:
+    text = text.rstrip() + """
+
+// PS4 (make_ps4_pch.py, 6): a register + displacement access takes the 0xE0000000 heap's host offset from its base
+// register (MP3's tools/patch_phys_base.py), so the compiler checks a pointer once for all its accesses.
+#define REX_LOAD_U8_B(b, d) (*(volatile u8*)(base + (u32)((b) + (d)) + REX_PHYS_HOST_OFFSET(b)))
+#define REX_LOAD_U16_B(b, d) __builtin_bswap16(*(volatile u16*)(base + (u32)((b) + (d)) + REX_PHYS_HOST_OFFSET(b)))
+#define REX_LOAD_U32_B(b, d) __builtin_bswap32(*(volatile u32*)(base + (u32)((b) + (d)) + REX_PHYS_HOST_OFFSET(b)))
+#define REX_LOAD_U64_B(b, d) __builtin_bswap64(*(volatile u64*)(base + (u32)((b) + (d)) + REX_PHYS_HOST_OFFSET(b)))
+#define REX_STORE_U8_B(b, d, y) (*(volatile u8*)(base + (u32)((b) + (d)) + REX_PHYS_HOST_OFFSET(b)) = (y))
+#define REX_STORE_U16_B(b, d, y) \\
+  (*(volatile u16*)(base + (u32)((b) + (d)) + REX_PHYS_HOST_OFFSET(b)) = __builtin_bswap16(y))
+#define REX_STORE_U32_B(b, d, y) \\
+  (*(volatile u32*)(base + (u32)((b) + (d)) + REX_PHYS_HOST_OFFSET(b)) = __builtin_bswap32(y))
+#define REX_STORE_U64_B(b, d, y) \\
+  (*(volatile u64*)(base + (u32)((b) + (d)) + REX_PHYS_HOST_OFFSET(b)) = __builtin_bswap64(y))
+"""
+
+# 7. An include guard around the whole header.
+if GUARD not in text:
+    text = f"#ifndef {GUARD}\n#define {GUARD}\n" + text.rstrip() + f"\n\n#endif  // {GUARD}\n"
+
+# Only when it changes: every recompiled unit depends on this header through the PCH.
+try:
+    previous = open(dst, encoding="utf-8").read()
+except OSError:
+    previous = None
+if previous == text:
+    print("unchanged", dst)
+else:
+    open(dst, "w", encoding="utf-8", newline="\n").write(text)
+    print("wrote", dst)
diff --git a/project/tools/patch_branch_traps.py b/project/tools/patch_branch_traps.py
new file mode 100755
index 0000000..0b5cbcc
--- /dev/null
+++ b/project/tools/patch_branch_traps.py
@@ -0,0 +1,147 @@
+#!/usr/bin/env python3
+"""Turn the codegen's unresolved-branch traps into the branches they are.
+
+ReXGlue v0.10.0 writes a trap (REX_FATAL("Unresolved branch/call from 0xA to 0xB")) for a branch whose target it could
+not tie to a call target, even when the target is known:
+
+  * a conditional branch back to the entry of the function it is in (a loop whose head is the function's first
+    instruction): the label loc_B is right there, but the branch is classified as a call to a function;
+  * a branch (b, bc) to the entry of another function that names.toml declares: a tail call the discover phase did not
+    record;
+  * a jump table case (REX_FATAL("Jump target 0xB unresolved at bctr 0xA")) whose label is in the same function.
+
+Within the function that holds loc_B the trap becomes `goto loc_B;` (exact). Otherwise, when a function starts at B,
+it becomes a tail call: `B(ctx, base); return;` (as the codegen writes the tail calls it resolved). `bl` (a call that
+comes back) becomes the call alone. A trap whose target is neither is left as it is and listed: the script exits 1.
+
+The codegen also writes `goto loc_B;` for a branch to B inside the address range of the function it is in when B is
+the entry of another function overlapping it (the label is then in that function, not here: GCC stops on "label used
+but not defined"). Those become the same tail call, or are listed if no function starts at B (name it in names.toml).
+
+Usage: patch_branch_traps.py generated/default/*.cpp     (idempotent)
+"""
+import re
+import sys
+
+TRAP = re.compile(r'^(\t+)(?:if \((.+?)\) )?REX_FATAL\("Unresolved (branch|call) from 0x([0-9A-F]{8}) to 0x([0-9A-F]{8})"\);$',
+                  re.M)
+INSN = re.compile(r'^\t// ([a-z.+-]+) ', re.M)
+
+
+def declare(text, names):
+    """The file's own declarations header only declares what the codegen called: add the functions the pass calls."""
+    names = sorted(n for n in names if f'DECLARE_REX_FUNC({n});' not in text)
+    if not names:
+        return text
+    m = list(re.finditer(r'^#include [^\n]*\n', text[:4096], re.M))
+    at = m[-1].end() if m else 0
+    return text[:at] + ''.join(f'DECLARE_REX_FUNC({n});\n' for n in names) + text[at:]
+
+
+def main(paths):
+    texts = {p: open(p, encoding='utf-8').read() for p in paths}
+    # Every function the generated code defines, by address: its registration table ({ 0xADDRESS, name }, in
+    # mp3_init.cpp), which also has the functions names.toml names.
+    starts = {}
+    for t in texts.values():
+        for m in re.finditer(r'\b0x([0-9A-F]{8}), (\w+)\b', t):
+            starts.setdefault(m.group(1), m.group(2))
+
+    fixed = {'goto': 0, 'tail call': 0, 'call': 0}
+    left = []
+    for path, t in texts.items():
+        if 'REX_FATAL("Unresolved' not in t:
+            continue
+        # Function bodies: from one definition to the next.
+        heads = [m.start() for m in re.finditer(r'^\S[^\n]*\) \{$', t, re.M)] + [len(t)]
+        out, last, called = [], 0, set()
+        for m in TRAP.finditer(t):
+            indent, cond, kind, src, dst = m.groups()
+            k = max(i for i, h in enumerate(heads) if h <= m.start()) if heads[0] <= m.start() else -1
+            lo, hi = (heads[k], heads[k + 1]) if k >= 0 else (0, len(t))
+            body = t[lo:hi]
+            insns = INSN.findall(t[max(lo, m.start() - 400):m.start()])
+            mnemonic = insns[-1] if insns else ''
+            if f'\nloc_{dst}:' in body:
+                new, what = f'goto loc_{dst};', 'goto'
+            elif dst in starts:
+                if mnemonic.startswith('bl') and not mnemonic.startswith(('blt', 'ble')) and kind == 'call':
+                    new, what = f'{starts[dst]}(ctx, base);', 'call'
+                else:
+                    new, what = f'{{ {starts[dst]}(ctx, base); return; }}', 'tail call'
+            else:
+                left.append(f'{path}: 0x{src} -> 0x{dst}')
+                continue
+            fixed[what] += 1
+            if what != 'goto':
+                called.add(starts[dst])
+            out.append(t[last:m.start()])
+            out.append(f'{indent}if ({cond}) {new}' if cond else f'{indent}{new}')
+            last = m.end()
+        out.append(t[last:])
+        new_text = declare(''.join(out), called)
+        if new_text != t:
+            open(path, 'w', encoding='utf-8').write(new_text)
+    # Jump table cases the codegen left as traps (REX_FATAL("Jump target 0xB unresolved at bctr 0xA")) although the
+    # case's label is in the same function (Max Payne 3's CRT _output, 56 cases at 0x83010E20): goto, or a tail call
+    # to a function that starts there.
+    fixed['case'] = 0
+    case = re.compile(r'REX_FATAL\("Jump target 0x([0-9A-F]{8}) unresolved at bctr 0x[0-9A-F]{8}"\);')
+    for path in paths:
+        t = open(path, encoding='utf-8').read()
+        if 'REX_FATAL("Jump target' not in t:
+            continue
+        heads = [m.start() for m in re.finditer(r'^\S[^\n]*\) \{$', t, re.M)] + [len(t)]
+        out, called = [t[:heads[0]]], set()
+        for lo, hi in zip(heads, heads[1:]):
+            body = t[lo:hi]
+            labels = set(re.findall(r'^loc_([0-9A-F]{8}):', body, re.M))
+
+            def fix_case(m):
+                dst = m.group(1)
+                if dst in labels:
+                    fixed['case'] += 1
+                    return f'goto loc_{dst};'
+                if dst in starts:
+                    fixed['case'] += 1
+                    called.add(starts[dst])
+                    return f'{{ {starts[dst]}(ctx, base); return; }}'
+                left.append(f'{path}: jump table case 0x{dst} (no label here, no function there)')
+                return m.group(0)
+            out.append(case.sub(fix_case, body))
+        open(path, 'w', encoding='utf-8').write(declare(''.join(out), called))
+    # Gotos to a label the function does not have.
+    fixed['foreign goto'] = 0
+    for path in paths:
+        t = open(path, encoding='utf-8').read()
+        heads = [m.start() for m in re.finditer(r'^\S[^\n]*\) \{$', t, re.M)] + [len(t)]
+        out, changed, called = [t[:heads[0]]], False, set()
+        for lo, hi in zip(heads, heads[1:]):
+            body = t[lo:hi]
+            labels = set(re.findall(r'^loc_([0-9A-F]{8}):', body, re.M))
+
+            def fix(m):
+                nonlocal changed
+                dst = m.group(1)
+                if dst in labels:
+                    return m.group(0)
+                if dst not in starts:
+                    left.append(f'{path}: goto 0x{dst} (no label here, no function there)')
+                    return m.group(0)
+                changed = True
+                called.add(starts[dst])
+                fixed['foreign goto'] += 1
+                return f'{{ {starts[dst]}(ctx, base); return; }}'
+            out.append(re.sub(r'goto loc_([0-9A-F]{8});', fix, body))
+        if changed:
+            open(path, 'w', encoding='utf-8').write(declare(''.join(out), called))
+    print(f"patch_branch_traps: {fixed['goto']} gotos, {fixed['tail call']} tail calls, {fixed['call']} calls; "
+          f"{fixed['foreign goto']} gotos into another function made tail calls; {fixed['case']} jump table cases; "
+          f"{len(left)} left")
+    for line in left:
+        print('  left:', line)
+    return 1 if left else 0
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv[1:]))
diff --git a/project/tools/patch_game_fixes.py b/project/tools/patch_game_fixes.py
new file mode 100644
index 0000000..206830b
--- /dev/null
+++ b/project/tools/patch_game_fixes.py
@@ -0,0 +1,159 @@
+#!/usr/bin/env python3
+"""vig8-ps4: fixes to the game's own code, applied to the generated C++ (build-vig8.sh codegen, after the speed passes).
+
+Each fix names its guest function and replaces exact pieces of generated code. A fix whose anchors are not found
+exactly as often as expected in the files given stops the build: the codegen or a pass changed that code, look at the
+fix again.
+
+usage: patch_game_fixes.py vig8_recomp.*.cpp
+"""
+import re
+import sys
+
+# The generated code keeps a register either in a local (L_r27) or in the context (ctx.r27), depending on the passes.
+REG = r"(?:L_|ctx\.)"
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Road patch subdivision work stack (v00.08)
+#
+# sub_8211F3B8 tests a ray against a curved road patch by subdividing it: an explicit work stack of 256-byte entries
+# (16 quadwords of control points) at r1+1392 in its 9,840-byte frame, 32 entries (r1+1392 .. r1+9584, the saved
+# registers after it). At 0x8211FB04 (mr r27,r30) a sub-patch whose projected extent is still at or above the
+# threshold is pushed; nothing limits the depth. With an infinite or enormous extent (a ray built from a zero or
+# exploded vector) every sub-patch is pushed again: in v00.07 (2026-11-24, 20 minutes into a race) the stack grew to
+# ~110 entries, through the callers' frames, and the copy into the next entry crossed the main thread's guest stack
+# top (write of 0x70250000) - "Unhandled guest access violation", the app ended. Here a push is made only while the
+# entry after it still fits; a full stack leaves the sub-patch out (logged by vig8_subdivision_stack_full).
+SUBDIVISION_RE = re.compile(
+    r"^loc_8211FB04:\n\t// mr r27,r30\n\t(" + REG + r"r27)\.u64 = (" + REG + r"r30)\.u64;\n", re.M)
+
+
+def subdivision_fix(m):
+    r27, r30 = m.group(1), m.group(2)
+    r1 = r27[:-3] + "r1"
+    return (
+        "loc_8211FB04:\n"
+        "\t// mr r27,r30\n"
+        "\t// vig8-ps4 (patch_game_fixes.py): only while the next 256-byte entry fits the 32-entry work stack.\n"
+        f"\tif ({r30}.u32 + 256u <= {r1}.u32 + 9584u) {{\n"
+        f"\t\t{r27}.u64 = {r30}.u64;\n"
+        "\t} else {\n"
+        f"\t\tvig8_subdivision_stack_full({r1}.u32);\n"
+        "\t}\n")
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# The 3D scene's anti-aliasing (v00.10)
+#
+# The scene renderer sub_820BE790 (per view, every frame) calls sub_82130D00(renderer, 4) - the MSAA mode the render
+# targets are created with (0x82482D90 = 2: 4x) - and sub_82130D28(rects, 16, 8 bytes a sample, 4 samples, width,
+# height, 0, 0), which splits the screen until a piece fits the 360's 2048 EDRAM tiles: at 1280x720 with 4x MSAA four
+# quadrants (640x384, 640x336). With more than one piece it sets them on the renderer (sub_82130EA0), and the D3D
+# runtime's predicated tiling (BeginTiling sub_82140FD0 / EndTiling sub_82141350, run by its worker threads'
+# tiling program, sub_82151048) replays the whole scene once per piece. The GPU is meant to skip the draws outside a
+# piece from the screen extents it writes for each draw (EVENT_WRITE_EXT); the SDK writes the whole screen there (as
+# Xenia does), so the GPU emulation - the port's bottleneck - translated every scene draw 4 times.
+#
+# The sample count becomes vig8_antialiasing's (vig8_ps4_game.cpp): with 1 sample the scene fits the EDRAM, the
+# renderer gets one piece and takes its no-tiling branch (the one it uses at SD resolutions), and every draw is
+# translated once. In that branch the pieces of an earlier 4x frame are cleared as the game's other renderers do
+# (sub_82130EA0(renderer, 0, 0)), so the setting can change while the game runs.
+MSAA_MODE_RE = re.compile(r"^\t// li r4,4\n\t(" + REG + r")r4\.s64 = 4;\n(?=\t// bl 0x82130d00\n)", re.M)
+TILES_SAMPLES_RE = re.compile(
+    r"^\t// li r6,4\n\t(" + REG + r")r6\.s64 = 4;\n(?=\t// li r5,8\n\t(?:L_|ctx\.)r5\.s64 = 8;\n\t// li r4,16\n"
+    r"\t(?:L_|ctx\.)r4\.s64 = 16;\n\t// addi r3,r1,1776\n\t(?:L_|ctx\.)r3\.s64 = (?:L_|ctx\.)r1\.s64 \+ 1776;\n"
+    r"\t// bl 0x82130d28\n)", re.M)
+NO_TILING_RE = re.compile(r"^loc_820BEC98:\n(?=\t// li r5,0\n)", re.M)
+
+
+def msaa_mode_fix(m):
+    return (
+        "\t// li r4,4\n"
+        "\t// vig8-ps4 (patch_game_fixes.py): the scene's MSAA samples, vig8_antialiasing (4 = the original).\n"
+        f"\t{m.group(1)}r4.s64 = vig8_scene_msaa_begin();\n")
+
+
+def tiles_samples_fix(m):
+    return (
+        "\t// li r6,4\n"
+        "\t// vig8-ps4 (patch_game_fixes.py): the same samples for the EDRAM pieces (1: one piece, no tiling).\n"
+        f"\t{m.group(1)}r6.s64 = vig8_scene_msaa_samples();\n")
+
+
+def no_tiling_fix(prefix):
+    def fix(m):
+        return (
+            "loc_820BEC98:\n"
+            "\t// vig8-ps4 (patch_game_fixes.py): one piece - no tiling: clear an earlier 4x frame's pieces, as the\n"
+            "\t// game's other renderers do (sub_82130EA0(renderer, 0, 0)).\n"
+            "\tif (vig8_scene_single_pass()) {\n"
+            f"\t\t__fast__sub_82130EA0(ctx, base, {prefix}r31.u64, 0, 0);\n"
+            "\t}\n")
+    return fix
+
+
+DECLARATIONS = {
+    "subdivision": 'extern "C" void vig8_subdivision_stack_full(uint32_t guest_r1);  // vig8_ps4_game.cpp\n',
+    "antialiasing": ('extern "C" int32_t vig8_scene_msaa_begin(void);    // vig8_ps4_game.cpp\n'
+                     'extern "C" int32_t vig8_scene_msaa_samples(void);  // vig8_ps4_game.cpp\n'
+                     'extern "C" int32_t vig8_scene_single_pass(void);   // vig8_ps4_game.cpp\n'),
+}
+
+
+def count_in(texts, regex):
+    return [(path, len(regex.findall(text))) for path, text in texts.items() if regex.search(text)]
+
+
+def main():
+    texts = {}
+    for path in sys.argv[1:]:
+        with open(path, encoding="utf-8") as f:
+            texts[path] = f.read()
+    changed = {}  # path -> set of declaration keys
+    errors = []
+    applied = []
+
+    # Road patch subdivision.
+    hits = count_in(texts, SUBDIVISION_RE)
+    if sum(n for _, n in hits) != 1:
+        errors.append("sub_8211F3B8's push (loc_8211FB04) found %d times, expected once" % sum(n for _, n in hits))
+    else:
+        path = hits[0][0]
+        texts[path] = SUBDIVISION_RE.sub(subdivision_fix, texts[path])
+        changed.setdefault(path, set()).add("subdivision")
+        applied.append("sub_8211F3B8 subdivision work stack (%s)" % path)
+
+    # Anti-aliasing: three anchors, all in sub_820BE790's file.
+    found = {name: count_in(texts, regex) for name, regex in
+             (("msaa mode", MSAA_MODE_RE), ("tile samples", TILES_SAMPLES_RE), ("no-tiling branch", NO_TILING_RE))}
+    bad = [name for name, hits in found.items() if sum(n for _, n in hits) != 1]
+    paths = {hits[0][0] for hits in found.values() if hits}
+    if bad or len(paths) != 1:
+        errors.append("sub_820BE790's anti-aliasing anchors: %s" % ", ".join(
+            "%s found %d times" % (name, sum(n for _, n in hits)) for name, hits in found.items()))
+    else:
+        path = paths.pop()
+        text = texts[path]
+        prefix = MSAA_MODE_RE.search(text).group(1)
+        text = MSAA_MODE_RE.sub(msaa_mode_fix, text)
+        text = TILES_SAMPLES_RE.sub(tiles_samples_fix, text)
+        text = NO_TILING_RE.sub(no_tiling_fix(prefix), text)
+        texts[path] = text
+        changed.setdefault(path, set()).add("antialiasing")
+        applied.append("sub_820BE790 scene anti-aliasing (%s)" % path)
+
+    if errors:
+        sys.exit("patch_game_fixes: " + "; ".join(errors))
+    for path, keys in changed.items():
+        text = texts[path]
+        # The declarations after the file's includes (a linkage specification cannot go inside the function).
+        includes = list(re.finditer(r"^#include .*\n", text, re.M))
+        at = includes[-1].end() if includes else 0
+        text = text[:at] + "".join(DECLARATIONS[k] for k in sorted(keys)) + text[at:]
+        with open(path, "w", encoding="utf-8", newline="\n") as f:
+            f.write(text)
+    print("patch_game_fixes: %d fixes applied: %s" % (len(applied), "; ".join(applied)))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/project/tools/patch_inline_calls.py b/project/tools/patch_inline_calls.py
new file mode 100755
index 0000000..2a36ff9
--- /dev/null
+++ b/project/tools/patch_inline_calls.py
@@ -0,0 +1,135 @@
+#!/usr/bin/env python3
+"""Calls the compiler may inline (make_nx_pch.py's DEFINE_REX_FUNC).
+
+Every recompiled function is a weak, noinline alias (name) of its body (__imp__name), so that a hook can replace it:
+each call, even to a three-instruction getter, is a real call with the guest registers going through memory. A call to
+a function defined in the same file that no hook replaces is rewritten to call the body directly, which GCC may inline
+(it decides by size; the big ones stay calls). GTA IV's city is CPU-bound on the Switch (the game's update and
+render-list threads), with many small functions, so this is where the call overhead adds up. (From gears2-nx, Gears of
+War 2's port, in dantes-inferno-nx's version.)
+
+The hooked functions: a hook replaces a guest function by defining a strong symbol of its name (REX_HOOK_RAW(sub_X),
+REX_EXTERN(name) { ... }), and calls the original as __imp__<name>. So any generated function whose name appears in
+the sources the build compiles (mp3/src, the SDK) counts as hooked: its calls keep going through the alias.
+
+The register save/restore helpers (__savegprlr_N, __restgprlr_N, __savefpr_N, __restfpr_N, __savevmx_N, __restvmx_N)
+are a fifth of all calls and each is defined in one file only: their bodies are copied into
+mp3_inline_helpers.h as always-inline functions (rex_inl___savegprlr_26 ...), every file includes it, and
+every call to a helper becomes a call to its copy, so the stores and loads land in the caller.
+
+Usage: patch_inline_calls.py <source dir>... -- generated/default/vig8_recomp.*.cpp   (idempotent)
+"""
+
+import re
+import sys
+from pathlib import Path
+
+HELPER = r"__(?:save|rest)(?:gpr|gprlr|fpr|vmx)_\d+"
+DEFINE = re.compile(r"^DEFINE_REX_FUNC\(([A-Za-z_]\w*)\)", re.M)
+CALL = re.compile(r"(?<![\w])([A-Za-z_]\w*)\(ctx, base\);")
+IDENT = re.compile(r"\b[A-Za-z_]\w*\b")
+COMMENT = re.compile(r"//[^\n]*|/\*.*?\*/", re.S)
+
+
+def hooked_names(dirs, defined):
+    """The generated functions (of `defined`) the sources name outside comments: hooked, or called from native code.
+    The SDK's code generator (codegen/ folders, not in the NRO) names the helpers it looks for: skipped."""
+    names = set()
+    for d in dirs:
+        for p in Path(d).rglob("*"):
+            if p.suffix in (".cpp", ".h", ".hpp", ".cc", ".inc") and p.is_file() and "codegen" not in p.parts:
+                text = COMMENT.sub(" ", p.read_text(encoding="utf-8", errors="replace"))
+                for w in IDENT.findall(text):
+                    if w.startswith("__imp__"):
+                        w = w[len("__imp__"):]
+                    if w in defined:
+                        names.add(w)
+    return names
+
+
+def defined_names(paths):
+    names = set()
+    for p in paths:
+        names.update(DEFINE.findall(Path(p).read_text(encoding="utf-8", errors="surrogateescape")))
+    return names
+
+
+def patch(path, hooked):
+    text = Path(path).read_text(encoding="utf-8", errors="surrogateescape")
+    local = {n for n in DEFINE.findall(text) if not re.fullmatch(HELPER, n)} - hooked
+    count = 0
+
+    def repl(m):
+        nonlocal count
+        if m.group(1) in local:
+            count += 1
+            return "__imp__" + m.group(0)
+        return m.group(0)
+
+    new = CALL.sub(repl, text)
+    if count:
+        Path(path).write_text(new, encoding="utf-8", errors="surrogateescape")
+    return count
+
+
+HELPER_DEF = re.compile(r"^DEFINE_REX_FUNC\((" + HELPER + r")\) \{\n(.*?)^\}\n", re.M | re.S)
+HELPER_CALL = re.compile(r"(?<![\w])(" + HELPER + r")\(ctx, base\);")
+HEADER = "vig8_inline_helpers.h"
+INCLUDE = '#include "' + HEADER + '"\n'
+
+
+def write_helpers(paths, hooked):
+    bodies = {}
+    for p in paths:
+        text = Path(p).read_text(encoding="utf-8", errors="surrogateescape")
+        for name, body in HELPER_DEF.findall(text):
+            if name not in hooked and "goto " not in body and "loc_" not in body:
+                bodies[name] = body
+    out = ["// Generated by tools/patch_inline_calls.py: the register save/restore helpers, inlined at every call.",
+           "#pragma once", ""]
+    for name in sorted(bodies):
+        out.append(f"static inline __attribute__((always_inline)) void rex_inl_{name}(PPCContext& __restrict ctx, "
+                   f"uint8_t* base) {{")
+        out.append(bodies[name].rstrip("\n"))
+        out.append("}")
+        out.append("")
+    Path(paths[0]).with_name(HEADER).write_text("\n".join(out), encoding="utf-8")
+    return set(bodies)
+
+
+def inline_helpers(path, helpers):
+    text = Path(path).read_text(encoding="utf-8", errors="surrogateescape")
+    count = 0
+
+    def repl(m):
+        nonlocal count
+        if m.group(1) in helpers:
+            count += 1
+            return "rex_inl_" + m.group(0)
+        return m.group(0)
+
+    new = HELPER_CALL.sub(repl, text)
+    if INCLUDE not in new:
+        first = new.find("\n") + 1  # after #include "mp3_funcs.N.h"
+        new = new[:first] + INCLUDE + new[first:]
+    if new != text:
+        Path(path).write_text(new, encoding="utf-8", errors="surrogateescape")
+    return count
+
+
+def main(argv):
+    if "--" not in argv:
+        sys.exit(__doc__)
+    i = argv.index("--")
+    files = argv[i + 1:]
+    hooked = hooked_names(argv[:i], defined_names(files))
+    total = sum(patch(p, hooked) for p in files)
+    helpers = write_helpers(files, hooked)
+    inlined = sum(inline_helpers(p, helpers) for p in files)
+    print(f"patch_inline_calls: {total} same-file calls may be inlined, {inlined} helper calls inlined "
+          f"({len(helpers)} helpers); {len(hooked)} hooked functions kept as calls: {' '.join(sorted(hooked))}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
