@@ -0,0 +1,1242 @@
+#!/usr/bin/env python3
+"""Guest registers in host locals inside each recompiled function.
+
+(vig8-ps4: MP3-PS4's mp3/tools/patch_local_regs.py; the file names are vig8's.)
+
+Every guest register of the generated code is a field of the context (ctx.r3.u64, ctx.f1.f64, ctx.cr6.eq ...), and
+every guest memory access is a volatile or memcpy access through `base`. GCC cannot tell the two apart (a byte store
+may alias anything, and the build has -fno-strict-aliasing), so after each guest store it reloads every register it
+needs from ctx and writes each register back as soon as it changes. This pass gives every function its own copies of
+the registers it uses (L_r3, L_f1, L_cr6 ...), which nothing can alias, and keeps ctx exact only where other code
+can look at it: at calls and returns.
+
+Which registers have to go through ctx at a call is worked out for the whole program, from the code itself (not from
+the PowerPC calling convention, which the game's compiler does not always follow between its own functions):
+
+  REF(F)   the registers F (or anything it calls) may read before writing them: they hold F's inputs.
+  MOD(F)   the registers whose value in ctx may differ when F returns.
+  PRES(F)  the registers F saves on its stack at entry and loads back right before every return (the non-volatiles
+           of its prologue and epilogue, inline or through the __savegprlr_N/__savefpr_N helpers): F's own writes to
+           them are not seen by its caller, and their save does not count as a read.
+
+Both are fixpoints over the call graph. At a call to G the caller writes back the registers that changed since ctx
+was last exact ("dirty", a dataflow over labels and gotos) and that G may read or change (REF(G) | MOD(G)), and reads
+back MOD(G) after it. At a return F writes back the dirty registers its caller may read back (MOD(F)) and the saved
+ones whose ctx copy it changed on the way. Calls the code cannot see into are taken at the calling convention's word:
+indirect calls (bctrl), the kernel's imports and the hooked functions (native code) read and change every volatile
+register, and preserve the non-volatiles, r1 and r13 (the guest compiler cannot use its own conventions for a function
+whose address is taken). A jump through a table to a target outside it (the switch fallback) and a call followed by a
+return (a tail call, possibly into the rest of the same function) write everything back.
+
+The register save/restore helpers (rex_inl___savegprlr_N ...) are copied into each function first, so they work on
+the copies too. A function with anything the pass does not understand (another use of ctx) is left as it is; its REF
+and MOD still come from its text.
+
+A guest setjmp/longjmp, if a title needs one (dantes-inferno-nx does): where a host setjmp comes back from a longjmp,
+FiberRestoreContext(ctx, base) loads the guest registers the guest setjmp saved into ctx. That line counts as a call
+that reads nothing and may change every register; the function reloads all its copies after it.
+
+From gears2-nx (Gears of War 2's port, gow2/tools/patch_local_regs.py and gow2/CPU_OPTIMIZATION.md, which explains the
+analyses and the pitfalls met), in dantes-inferno-nx's version (conditional blocks may be skipped; the check build
+also poisons what a return does not hand back); here without the stack guard (this port's REX_FUNC_PROLOGUE has none).
+mp3/CPU_OPTIMIZATION.md says what is different for GTA IV.
+
+Usage: patch_local_regs.py <mp3_inline_helpers.h> <source dir>... -- generated/default/mp3_recomp.*.cpp
+(the source dirs: where the hooks are, as for patch_inline_calls.py)
+"""
+
+import os
+import re
+import sys
+from concurrent.futures import ProcessPoolExecutor
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Registers: one bit each.
+NAMES = ([f"r{i}" for i in range(32)] + [f"f{i}" for i in range(32)] + [f"v{i}" for i in range(128)] +
+         [f"cr{i}" for i in range(8)] + ["xer", "ctr", "lr", "reserved"])
+BIT = {n: i for i, n in enumerate(NAMES)}
+ALL = (1 << len(NAMES)) - 1
+
+
+def mask(names):
+    m = 0
+    for n in names:
+        m |= 1 << BIT[n]
+    return m
+
+
+def nonvolatile(reg):
+    if reg.startswith("cr"):
+        return reg in ("cr2", "cr3", "cr4")
+    kind, num = reg[0], reg[1:]
+    if kind in "rf" and num.isdigit():
+        return int(num) >= 14
+    if kind == "v" and num.isdigit():
+        n = int(num)
+        return 14 <= n <= 31 or n >= 64
+    return False
+
+
+NONVOL = mask(n for n in NAMES if nonvolatile(n))
+# The calling convention: a callee reads and changes any volatile register and preserves the rest (r1 and r13 too).
+# What such a callee may read: its arguments (r3-r10, f1-f13, v1-v13), the stack and thread pointers, the return
+# address, and XER (every compare copies its summary-overflow bit). What it may change: every volatile register.
+ARGS = mask([f"r{i}" for i in range(3, 11)] + [f"f{i}" for i in range(1, 14)] + [f"v{i}" for i in range(1, 14)])
+ABI_REF = ARGS | mask(["r1", "r2", "r13", "lr", "xer"])
+ABI_MOD = ALL & ~NONVOL & ~mask(["r1", "r13"])
+TRAP_REF = mask(["r3", "r4"])
+FASTARGS = __import__("os").environ.get("PLR_FASTARGS", "1") == "1" and __import__("os").environ.get("PLR_CHECK") != "1"
+FAST_GPRS = [f"r{i}" for i in range(3, 11)]
+# mp3-ps4 v00.68 (LRSAVE): an indirect call's target is a guest function, which reads lr only to save it.
+LRSAVE = __import__("os").environ.get("PLR_LRSAVE", "1") == "1"
+ABI_REF_INDIRECT = ABI_REF & ~mask(["lr"]) if LRSAVE else ABI_REF
+TERNKILL = __import__("os").environ.get("PLR_TERNKILL", "1") == "1"
+# One statement that assigns a whole register (its right-hand side may select with ?:).
+WHOLE_ASSIGN = re.compile(r"^ctx\.(?:r\d+|f\d+)\.(?:u64|s64|f64) = [^;{}]*;$")
+LR_SAVE_COPY = re.compile(r"^ctx\.r\d+\.u64 = ctx\.lr;$")
+CHECK = os.environ.get("PLR_CHECK") == "1"
+# Imports that look at the whole register state (a context for a crash report or an exception): this function's
+# registers are all written back before them (the callers' non-volatiles may be stale there).
+CTX_IMPORTS = {"RtlCaptureContext", "RtlRaiseException", "RtlUnwind", "KeBugCheck", "KeBugCheckEx"}
+
+REG = r"(?:r\d+|f\d+|v\d+|cr\d|xer|ctr|lr|reserved)"
+OCC = re.compile(r"\bctx\.(" + REG + r")\b")
+CALL = re.compile(r"\b([A-Za-z_]\w*)\(ctx, base\);")
+TRAP = re.compile(r"\bppc_trap\(ctx, base, \d+\);")
+INDIRECT = "REX_CALL_INDIRECT_FUNC("
+GOTO = re.compile(r"\bgoto (loc_[0-9A-F]+);")
+LABEL = re.compile(r"^(loc_[0-9A-F]+):\s*$")
+OTHER_CTX = re.compile(r"\bctx\b")
+FIBER = "FiberRestoreContext"  # FiberRestoreContext(ctx, base);: back from a guest longjmp, see the docstring
+KEEP = re.compile(r"\bctx\.(?:fpscr|msr)\b")  # stays in ctx: FPSCR and MSR emulation
+COMPOUND = re.compile(r"^(?:\+|-|\*|/|%|&|\||\^|<<|>>)=")
+HELPER_DEF = re.compile(r"^static inline __attribute__\(\(always_inline\)\) void (rex_inl_\w+)\(PPCContext& __restrict "
+                        r"ctx, uint8_t\* base\) \{\n(.*?)^\}\n", re.M | re.S)
+HELPER_CALL = re.compile(r"^\t(rex_inl___(?:save|rest)(?:gpr|gprlr|fpr|vmx)_\d+)\(ctx, base\);\n", re.M)
+
+# Statements the frame analysis understands (on the code with ctx. names).
+R_ADDI = re.compile(r"^ctx\.(r\d+)\.s64 = ctx\.(r\d+)\.s64 \+ (-?\d+);$")
+R_MR = re.compile(r"^ctx\.(r\d+)\.u64 = ctx\.(r\d+)\.u64;$")
+R_LI = re.compile(r"^ctx\.(r\d+)\.s64 = (-?\d+);$")
+EA_D = re.compile(r"^ea = (-?\d+) \+ ctx\.(r\d+)\.u32;$")
+EA_X = re.compile(r"^ea = ctx\.(r\d+)\.u32 \+ ctx\.(r\d+)\.u32;$")
+STWU = re.compile(r"^REX_STORE_U32\(ea, ctx\.(r\d+)\.u32\);$")
+R1_EA = re.compile(r"^ctx\.r1\.u32 = ea;$")
+BACKCHAIN = re.compile(r"^ctx\.r1\.u64 = REX_S?LOAD_U32\(ctx\.r1\.u32 \+ 0\);$")
+SAVE = re.compile(r"^REX_SSTORE_U64\(ctx\.(r\d+)\.u32 \+ (-?\d+), ctx\.((?:r|f)\d+)\.u64\);$")
+RESTORE = re.compile(r"^ctx\.((?:r|f)\d+)\.u64 = REX_SLOAD_U64\(ctx\.(r\d+)\.u32 \+ (-?\d+)\);$")
+
+
+def code_part(line):
+    i = line.find("//")
+    return line if i < 0 else line[:i]
+
+
+def access(code, m):
+    """(writes, full) for the occurrence m: whether it writes the register and whether it replaces all of it."""
+    reg = m.group(1)
+    rest = code[m.end():]
+    f = re.match(r"(\.(\w+))?(\[[^\]]*\])?\s*", rest)
+    field, index = f.group(2), f.group(3)
+    after = rest[f.end():]
+    if field in ("compare", "setFromMask"):
+        return True, True
+    if field == "set_raw":
+        return True, True
+    if after.startswith("=") and not after.startswith("=="):
+        if reg == "reserved":
+            return True, True  # lwarx: only its stwcx. reads it
+        if index:
+            return True, False
+        if field is None:
+            return True, True
+        if reg[0] in "rf" or reg in ("ctr", "reserved"):
+            return True, field in ("u64", "s64", "f64")
+        return True, False  # a field of a CR, XER, vector
+    if COMPOUND.match(after) or after.startswith("++") or after.startswith("--"):
+        return True, False
+    before = code[:m.start()]
+    if re.search(r"store\w*\(\s*(?:\([^()]*\*\)\s*)?&?$", before):
+        # A 128-bit store into a vector register replaces it; anything else is partial.
+        full = reg[0] == "v" and re.search(r"simde_mm_store_(?:si128|ps)\(\s*(?:\([^()]*\*\)\s*)?$", before) is not None
+        return True, full
+    if re.search(r"load\w*\(\s*(?:\([^()]*\*\)\s*)?&?$", before):
+        return False, False
+    if before.endswith("&") or re.search(r"\*\)\s*$", before):
+        return True, False
+    return False, False
+
+
+def find_indirect(code):
+    spans = []
+    i = code.find(INDIRECT)
+    while i >= 0:
+        j = i + len(INDIRECT)
+        depth = 1
+        while depth and j < len(code):
+            if code[j] == "(":
+                depth += 1
+            elif code[j] == ")":
+                depth -= 1
+            j += 1
+        if code[j:j + 1] == ";":
+            j += 1
+        spans.append((i, j))
+        i = code.find(INDIRECT, j)
+    return spans
+
+
+class Skip(Exception):
+    pass
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Parsing one function.
+
+class Func:
+    """What the analyses need from one function body."""
+
+    def __init__(self, name, body):
+        self.name = name
+        self.body = body
+        self.start = 0
+        while self.start < len(body) and body[self.start].strip().startswith("REX_FUNC_PROLOGUE"):
+            self.start += 1
+        self.ok = True  # can be rewritten (no unknown ctx use)
+        self.reason = ""
+        n = len(body)
+        self.n = n
+        self.use = [0] * n      # read (a partial write reads the rest)
+        self.kill = [0] * n     # replaced
+        self.wr = [0] * n       # written
+        self.calls = [None] * n  # list of (kind, target) on the line; kind: 'd' direct, 'i' indirect, 's' switch
+        #                          fallback, 't' trap, 'x' FiberRestoreContext
+        self.plain = [False] * n
+        self.tail = [False] * n
+        self.returns = [False] * n
+        self.succ = [None] * n
+        self.depth = [1] * n
+        labels = {}
+        depth = 1
+        gotos = []
+        # For each open brace: whether what is inside may not run (opened by an if/else/switch line), and its line.
+        cond_stack = []
+        skips = []  # (line opening a conditional block, line closing it): the path that does not run the block
+        prologue = True  # LRSAVE: before any label, call, goto or condition
+        for i, line in enumerate(body):
+            lm = LABEL.match(line)
+            if lm:
+                labels[lm.group(1)] = i
+            code = code_part(line)
+            self.depth[i] = depth
+            if i >= self.start and code.strip():
+                use = kill = wr = 0
+                for m in OCC.finditer(code):
+                    b = 1 << BIT[m.group(1)]
+                    w, full = access(code, m)
+                    if w:
+                        wr |= b
+                        if full:
+                            kill |= b
+                        else:
+                            use |= b
+                    else:
+                        use |= b
+                # x = x + 1: the read comes first. A write that may not happen (in an if, in a conditional block)
+                # replaces nothing for certain.
+                if any(c for c, _ in cond_stack) or re.search(r"\b(?:if|else|switch|case|default|for|while|do)\b", code):
+                    kill = 0
+                elif "?" in code and not (TERNKILL and WHOLE_ASSIGN.match(code.strip())):
+                    kill = 0
+                if lm or GOTO.search(code) or "(ctx, base)" in code or INDIRECT in code or \
+                        re.search(r"\b(?:if|else|switch|case|for|while|do)\b", code):
+                    prologue = False
+                if LRSAVE and prologue and LR_SAVE_COPY.match(code.strip()):
+                    use &= ~(1 << BIT["lr"])
+                self.use[i], self.kill[i], self.wr[i] = use, kill, wr
+                stripped = OCC.sub("", code)
+                stripped = KEEP.sub("", stripped)
+                stripped = CALL.sub("", stripped)
+                stripped = TRAP.sub("", stripped)
+                stripped = stripped.replace(INDIRECT, "")
+                if OTHER_CTX.search(stripped) or "ppc_setjmp" in code or "SEH_" in code:
+                    self.ok = False
+                    self.reason = "ctx use: " + line.strip()[:60]
+                calls = [("i", None) for _ in find_indirect(code)]
+                for m in CALL.finditer(code):
+                    calls.append(("x", None) if m.group(1) == FIBER else ("d", m.group(1)))
+                if TRAP.search(code):
+                    calls.append(("t", None))
+                if calls:
+                    self.calls[i] = calls
+                    s = code.strip()
+                    self.plain[i] = len(calls) == 1 and calls[0][0] != "t" and (
+                        bool(re.fullmatch(r"[A-Za-z_]\w*\(ctx, base\);", s)) or
+                        (s.startswith(INDIRECT) and find_indirect(s) == [(0, len(s))]))
+                self.returns[i] = "return;" in code
+                gotos.append((i, GOTO.findall(code)))
+            conditional = re.search(r"\b(?:if|else|switch|case|default|for|while|do)\b", code) is not None
+            for ch in code:
+                if ch == "{":
+                    cond_stack.append((conditional, i))
+                elif ch == "}" and cond_stack:
+                    c, opened = cond_stack.pop()
+                    if c and opened != i:
+                        skips.append((opened, i))
+            depth += code.count("{") - code.count("}")
+        if depth != 1:
+            raise Skip("unbalanced braces")
+        # Switch fallback: REX_CALL_INDIRECT_FUNC inside a switch's default.
+        for i in range(n):
+            if self.calls[i] and any(k == "i" for k, _ in self.calls[i]) and self.depth[i] > 1:
+                j = i - 1
+                while j >= 0 and not code_part(body[j]).strip():
+                    j -= 1
+                if j >= 0 and code_part(body[j]).strip() == "default:":
+                    self.calls[i] = [("s", None) if k == "i" else (k, t) for k, t in self.calls[i]]
+        # Tail calls: a call statement followed by return.
+        for i in range(n):
+            if self.calls[i] and self.plain[i]:
+                for j in range(i + 1, n):
+                    s = code_part(body[j]).strip()
+                    if s:
+                        self.tail[i] = s == "return;"
+                        break
+                else:
+                    self.tail[i] = True
+        # Control flow: lines fall through unless they are an unconditional goto/return at the top level. A conditional
+        # block may also be skipped: an edge from its opening line to its closing one. (Falling through the block's
+        # lines alone is not enough: a call in it clears the dirty registers, `if (c) { X(ctx, base); return; }` made
+        # the code after the block look clean on the path where c is false, and r1 went unwritten before the next
+        # call there: the callee's frame overwrote this function's saved registers.)
+        gmap = dict(gotos)
+        skipmap = {}
+        for a, b in skips:
+            skipmap.setdefault(a, []).append(b)
+        for i in range(n):
+            s = code_part(body[i]).strip()
+            term = self.depth[i] == 1 and (s == "return;" or (s.startswith("goto ") and s.endswith(";") and
+                                                               s.count(";") == 1))
+            succ = [] if term else [i + 1]
+            succ.extend(b for b in skipmap.get(i, ()) if b not in succ)
+            for g in gmap.get(i, ()):
+                if g not in labels:
+                    raise Skip("goto to unknown label " + g)
+                succ.append(labels[g])
+            self.succ[i] = succ
+        self.used = 0
+        self.written = 0
+        for i in range(n):
+            self.used |= self.use[i] | self.wr[i]
+            self.written |= self.wr[i]
+        self.reach = self._reach()
+        self.sp_keep = False
+        self.pres, self.save_lines, self.restore_lines = self._preserved()
+
+    def _reach(self):
+        reach = [False] * (self.n + 1)
+        work = [0]
+        reach[0] = True
+        while work:
+            i = work.pop()
+            if i >= self.n:
+                continue
+            for s in self.succ[i]:
+                if not reach[s]:
+                    reach[s] = True
+                    work.append(s)
+        return reach
+
+    def _preserved(self):
+        """PRES: registers saved at entry (straight-line prefix) into a frame slot and loaded back from it right
+        before every return (no write and no call in between, but a tail call). Returns (mask, {line: reg})."""
+        body, n = self.body, self.n
+        # Symbolic values: register -> offset from the entry r1, for the registers that hold one; plus 'ea' and the
+        # back chain (the r1 the last stwu/stwux saved).
+        def step(state, code):
+            s = code.strip()
+            if not s:
+                return state
+            m = R_ADDI.match(s)
+            if m:
+                d, a, k = m.groups()
+                st = dict(state)
+                if a in st:
+                    st[d] = st[a] + int(k)
+                else:
+                    st.pop(d, None)
+                return st
+            m = R_MR.match(s)
+            if m:
+                d, a = m.groups()
+                st = dict(state)
+                if a in st:
+                    st[d] = st[a]
+                else:
+                    st.pop(d, None)
+                return st
+            m = EA_D.match(s)
+            if m:
+                k, a = m.groups()
+                st = dict(state)
+                if a in st:
+                    st["ea"] = st[a] + int(k)
+                else:
+                    st.pop("ea", None)
+                return st
+            m = EA_X.match(s)
+            if m:
+                st = dict(state)
+                st.pop("ea", None)
+                return st
+            m = STWU.match(s)
+            if m:
+                st = dict(state)
+                if m.group(1) in st:
+                    st["bc"] = st[m.group(1)]
+                else:
+                    st.pop("bc", None)
+                return st
+            if R1_EA.match(s):
+                st = dict(state)
+                if "ea" in st:
+                    st["r1"] = st["ea"]
+                else:
+                    st.pop("r1", None)
+                return st
+            if BACKCHAIN.match(s):
+                st = dict(state)
+                if "bc" in st:
+                    st["r1"] = st["bc"]
+                else:
+                    st.pop("r1", None)
+                st.pop("bc", None)
+                return st
+            # Anything else that writes a tracked register forgets it.
+            st = state
+            for m in OCC.finditer(s):
+                r = m.group(1)
+                if r in state and access(s, m)[0]:
+                    if st is state:
+                        st = dict(state)
+                    st.pop(r, None)
+            if "ea =" in s and "ea" in st:
+                if st is state:
+                    st = dict(state)
+                st.pop("ea", None)
+            return st
+
+        # Forward must-analysis of the symbolic values (intersection at joins).
+        TOP = None
+        states = [TOP] * (n + 1)
+        states[self.start] = {"r1": 0}
+        order = list(range(self.start, n))
+        changed = True
+        out = [TOP] * n
+        while changed:
+            changed = False
+            for i in order:
+                if states[i] is TOP:
+                    continue
+                o = step(states[i], code_part(body[i]))
+                if self.calls[i]:
+                    # A call leaves r1 alone (MOD never has r1, see ABI_MOD); everything volatile is forgotten.
+                    o = {k: v for k, v in o.items() if k in ("r1", "bc") or (k.startswith("r") and k != "ea" and
+                                                                              nonvolatile(k))}
+                if o != out[i]:
+                    out[i] = o
+                    for s in self.succ[i]:
+                        cur = states[s]
+                        new = dict(o) if cur is TOP else {k: v for k, v in cur.items() if o.get(k) == v}
+                        if new != cur:
+                            states[s] = new
+                            changed = True
+        # mp3-ps4 v00.67 (SPKEEP): r1 back at its entry value at every reachable return (and the end).
+        self.sp_keep = True
+        reached = False
+        for i in range(self.start, n):
+            if out[i] is TOP:
+                continue
+            ends = self.returns[i] or any(s >= n for s in self.succ[i])
+            if ends:
+                reached = True
+                if out[i].get("r1") != 0:
+                    self.sp_keep = False
+                    break
+        if not reached:
+            self.sp_keep = False
+        # Saves in the straight-line prefix (before any label, branch or call).
+        saves = {}       # slot -> reg
+        save_lines = {}  # line -> reg
+        written = 0
+        for i in range(self.start, n):
+            line = body[i]
+            code = code_part(line).strip()
+            if LABEL.match(line) or self.calls[i] or GOTO.search(code) or "return;" in code or "if (" in code or \
+                    "switch" in code:
+                break
+            m = SAVE.match(code)
+            if m and states[i] is not TOP:
+                base_reg, k, reg = m.groups()
+                if base_reg in states[i] and not (written >> BIT[reg] & 1) and nonvolatile(reg):
+                    slot = states[i][base_reg] + int(k)
+                    if slot in saves:
+                        saves[slot] = None
+                    else:
+                        saves[slot] = reg
+                        save_lines[i] = reg
+            written |= self.wr[i]
+        cand = {r for r in saves.values() if r}
+        if not cand:
+            return 0, {}, {}
+        # Any other store into a save slot through a known frame address spoils it.
+        for i in range(self.start, n):
+            if i in save_lines or states[i] is TOP:
+                continue
+            code = code_part(body[i]).strip()
+            m = re.match(r"^REX_S?STORE_U(\d+)\((?:ctx\.(r\d+)\.u32 \+ (-?\d+)|ea),", code)
+            if m:
+                size = int(m.group(1)) // 8
+                if m.group(2):
+                    if m.group(2) not in states[i]:
+                        continue
+                    addr = states[i][m.group(2)] + int(m.group(3))
+                elif "ea" in states[i]:
+                    addr = states[i]["ea"]
+                else:
+                    continue
+                for slot, reg in list(saves.items()):
+                    if reg and addr < slot + 8 and slot < addr + size:
+                        cand.discard(reg)
+        # Must-analysis: the registers restored from their slot with nothing after (but a tail call).
+        cmask = mask(cand)
+        rest_in = [None] * (n + 1)
+        rest_in[self.start] = 0
+        work = [self.start]
+        ret_ok = cmask
+        reached_ret = False
+        restore_lines = {}
+        while work:
+            i = work.pop()
+            if i >= n:
+                continue
+            cur = rest_in[i]
+            code = code_part(body[i]).strip()
+            m = RESTORE.match(code)
+            o = cur & ~self.wr[i]
+            if m:
+                reg, base_reg, k = m.groups()
+                st = states[i]
+                if reg in cand and st is not TOP and base_reg in st:
+                    slot = st[base_reg] + int(k)
+                    if saves.get(slot) == reg:
+                        o |= 1 << BIT[reg]
+                        restore_lines[i] = reg
+            if self.calls[i] and not self.tail[i]:
+                o = 0
+            if self.returns[i]:
+                reached_ret = True
+                ret_ok &= o
+            for s in self.succ[i]:
+                if s >= n:
+                    # Falling off the end is a return too.
+                    reached_ret = True
+                    ret_ok &= o
+                    continue
+                if rest_in[s] is None:
+                    rest_in[s] = o
+                    work.append(s)
+                elif rest_in[s] & o != rest_in[s]:
+                    rest_in[s] &= o
+                    work.append(s)
+        if not reached_ret:
+            return 0, {}, {}
+        pres = ret_ok & cmask
+        return (pres, {i: r for i, r in save_lines.items() if pres >> BIT[r] & 1},
+                {i: r for i, r in restore_lines.items() if pres >> BIT[r] & 1})
+
+
+def parse_file(path, helpers):
+    text = open(path, encoding="utf-8", errors="surrogateescape").read()
+
+    def inline(m):
+        body = helpers.get(m.group(1))
+        if body is None:
+            return m.group(0)
+        return "\t{\n" + "".join("\t" + l + "\n" for l in body) + "\t}\n"
+
+    text = HELPER_CALL.sub(inline, text)
+    lines = text.split("\n")
+    funcs = []  # (name, start line index of DEFINE, end index of }, Func or None)
+    i = 0
+    while i < len(lines):
+        line = lines[i]
+        if line.startswith("DEFINE_REX_FUNC(") and line.endswith("{"):
+            j = i + 1
+            while lines[j] != "}":
+                j += 1
+            name = line[len("DEFINE_REX_FUNC("):line.index(")")]
+            try:
+                f = Func(name, lines[i + 1:j])
+            except Skip as e:
+                f = None
+                print(f"patch_local_regs: {name} left as it is ({e})", file=sys.stderr)
+            funcs.append((name, i, j, f))
+            i = j
+        i += 1
+    return lines, funcs
+
+
+def load_helpers(path):
+    text = open(path, encoding="utf-8").read()
+    helpers = {}
+    for name, body in HELPER_DEF.findall(text):
+        helpers[name] = [l for l in body.split("\n") if l.strip() and not l.strip().startswith("REX_FUNC_PROLOGUE")
+                         and l.strip() != "return;"]
+    return helpers
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Phase 1 (per file): the facts the whole-program fixpoint needs.
+
+def summarize(f):
+    """Compact form of a function for the REF/MOD fixpoint: basic blocks (use, kill) and call nodes."""
+    n = f.n
+    nodes = []  # (use, kill, call) with call = None or (kind, target)
+    node_of = {}
+    # One node per line (lines without anything are kept as empty nodes so successors stay simple), but only
+    # reachable ones matter.
+    for i in range(n):
+        use, kill = f.use[i], f.kill[i]
+        if i in f.save_lines:
+            use &= ~(1 << BIT[f.save_lines[i]])
+        call = None
+        if f.calls[i]:
+            call = tuple(f.calls[i])
+        nodes.append((use, kill, call, tuple(f.succ[i]), f.tail[i], f.returns[i]))
+    return {
+        "nodes": nodes,
+        "start": f.start,
+        "written": f.written,
+        "pres": f.pres,
+        "sp_keep": f.sp_keep,
+        "used": f.used,
+    }
+
+
+def phase1(args):
+    path, helpers = args
+    _, funcs = parse_file(path, helpers)
+    out = {}
+    for name, _, _, f in funcs:
+        # A function the pass cannot follow (another use of ctx) may read and change anything.
+        out[name] = summarize(f) if f is not None and f.ok else None
+    return out
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Phase 2: REF / MOD fixpoints.
+
+def call_ref_mod(kind, target, ref, mod, hooked, defined):
+    if kind == "t":
+        return TRAP_REF, 0
+    if kind == "x":
+        return 0, ALL
+    if kind == "s":
+        # A jump table's out-of-range path: dispatched like a tail call through a pointer.
+        return ABI_REF, ABI_MOD
+    if kind == "i":
+        return ABI_REF_INDIRECT, ABI_MOD
+    # direct
+    if target.startswith("__imp__"):
+        inner = target[len("__imp__"):]
+        if inner in defined:
+            return ref.get(inner, ALL), mod.get(inner, ALL)
+        return ABI_REF, ABI_MOD  # a kernel import
+    r, m = ref.get(target, ALL), mod.get(target, ALL)
+    if target in hooked or target not in defined:  # (functions codegen/names.toml names are the game's own code)
+        r |= ABI_REF
+        m |= ABI_MOD
+    return r, m
+
+
+def liveness(s, ref, mod, hooked, defined, at_return, calls_read=True):
+    """Backward liveness over the lines: a call reads REF of its callee (and changes nothing for certain), a return
+    (and the end of the function) reads at_return. Returns (live_in, live_out) per line."""
+    nodes = s["nodes"]
+    n = len(nodes)
+    live = [0] * (n + 1)
+    live[n] = at_return
+    outs = [0] * n
+    callref = [0] * n
+    for i in range(n):
+        call = nodes[i][2]
+        if call and calls_read:
+            for kind, target in call:
+                callref[i] |= call_ref_mod(kind, target, ref, mod, hooked, defined)[0]
+    changed = True
+    while changed:
+        changed = False
+        for i in range(n - 1, -1, -1):
+            use, kill, call, succ, tail, ret = nodes[i]
+            out = 0
+            for t in succ:
+                out |= live[t]
+            outs[i] = out
+            inn = (out & ~kill) | use | callref[i]
+            if ret:
+                inn |= at_return
+            if inn != live[i]:
+                live[i] = inn
+                changed = True
+    return live, outs
+
+
+def compute_ref(s, ref, mod, hooked, defined):
+    live, _ = liveness(s, ref, mod, hooked, defined, 0)
+    n = len(s["nodes"])
+    return live[s["start"]] if s["start"] < n else 0
+
+
+def compute_mod(s, ref, mod, hooked, defined):
+    m = s["written"]
+    tailm = 0
+    for use, kill, call, succ, tail, ret in s["nodes"]:
+        if call:
+            for kind, target in call:
+                _, cm = call_ref_mod(kind, target, ref, mod, hooked, defined)
+                if tail:
+                    tailm |= cm
+                else:
+                    m |= cm
+    return (m & ~s["pres"]) | tailm
+
+
+def fixpoint(summ, hooked):
+    defined = set(summ)
+    callers = {}
+    for name, s in summ.items():
+        if s is None:
+            continue
+        for use, kill, call, succ, tail, ret in s["nodes"]:
+            if call:
+                for kind, target in call:
+                    if kind == "d":
+                        t = target[len("__imp__"):] if target.startswith("__imp__") else target
+                        callers.setdefault(t, set()).add(name)
+    ref = {name: 0 for name in summ}
+    mod = {name: 0 for name in summ}
+    for name, s in summ.items():
+        if s is None:
+            ref[name] = ALL
+            mod[name] = ALL
+    # MOD first (it does not depend on REF), then REF.
+    for which in ("mod", "ref"):
+        work = [name for name, s in summ.items() if s is not None]
+        inwork = set(work)
+        rounds = 0
+        while work:
+            name = work.pop()
+            inwork.discard(name)
+            rounds += 1
+            s = summ[name]
+            if which == "mod":
+                new = compute_mod(s, ref, mod, hooked, defined)
+                old = mod[name]
+                if new != old:
+                    mod[name] = new | old
+            else:
+                new = compute_ref(s, ref, mod, hooked, defined)
+                old = ref[name]
+                if new != old:
+                    ref[name] = new | old
+            if new != old:
+                for c in callers.get(name, ()):
+                    if c not in inwork and summ.get(c) is not None:
+                        inwork.add(c)
+                        work.append(c)
+    return ref, mod
+
+
+def compute_must(s, must, hooked, defined):
+    """The registers replaced on every path to every return (see MUSTMOD in the docstring of make_plr_must.py)."""
+    nodes = s["nodes"]
+    n = len(nodes)
+    start = s["start"]
+    if start >= n:
+        return 0
+    TOP = None
+    din = [TOP] * n
+    din[start] = 0
+    work = [start]
+    at_ret = TOP
+    while work:
+        i = work.pop()
+        cur = din[i]
+        use, kill, call, succ, tail, ret = nodes[i]
+        o = cur | kill
+        tail_must = 0
+        if call:
+            for kind, target in call:
+                if kind != "d":
+                    continue
+                t = target[len("__imp__"):] if target.startswith("__imp__") else target
+                if t in defined and t not in hooked and must.get(t) is not None:
+                    if tail:
+                        tail_must |= must[t]
+                    else:
+                        o |= must[t]
+        if ret or tail:
+            r = o | tail_must
+            at_ret = r if at_ret is TOP else at_ret & r
+        for t in succ:
+            if t >= n:
+                at_ret = o if at_ret is TOP else at_ret & o
+                continue
+            if din[t] is TOP:
+                din[t] = o
+                work.append(t)
+            elif din[t] & ~o:
+                din[t] &= o
+                work.append(t)
+    if at_ret is TOP:
+        return 0
+    return at_ret & ~s["pres"]
+
+
+def fixpoint_must(summ, hooked):
+    """MUST for every function: a least fixpoint from 0 (a callee's MUST only adds), so recursion gives nothing."""
+    defined = set(summ)
+    callers = {}
+    for name, s in summ.items():
+        if s is None:
+            continue
+        for use, kill, call, succ, tail, ret in s["nodes"]:
+            if call:
+                for kind, target in call:
+                    if kind == "d":
+                        t = target[len("__imp__"):] if target.startswith("__imp__") else target
+                        callers.setdefault(t, set()).add(name)
+    must = {name: (0 if s is not None else None) for name, s in summ.items()}
+    work = [name for name, s in summ.items() if s is not None]
+    inwork = set(work)
+    while work:
+        name = work.pop()
+        inwork.discard(name)
+        new = compute_must(summ[name], must, hooked, defined)
+        if new & ~must[name]:
+            must[name] |= new
+            for c in callers.get(name, ()):
+                if c not in inwork and summ.get(c) is not None:
+                    inwork.add(c)
+                    work.append(c)
+    return must
+
+
+# What native code may read in ctx after calling a guest function (thread entries, callbacks, the stack cut), and what
+# every function's return keeps exact on top of what its callers read after the call.
+RESULT_FLOOR = mask(["r1", "r3", "r4", "r13", "f1", "f2", "v2", "xer"])
+
+
+def fixpoint_liveout(summ, ref, mod, hooked, defined, native):
+    """LIVEOUT(F): the registers a caller may read after F returns (before writing them): from the liveness after
+    every call site of F, the callers' own LIVEOUT through their returns, and after every indirect call (any
+    function may be the target of one)."""
+    if any(s is None for s in summ.values()):
+        return {name: ALL for name in summ}
+    floor = RESULT_FLOOR
+    liveout = {name: floor for name in summ}
+    for name in native | hooked:
+        if name in liveout:
+            liveout[name] = ALL
+    work = list(summ)
+    inwork = set(work)
+    while work:
+        name = work.pop()
+        inwork.discard(name)
+        s = summ[name]
+        live, outs = liveness(s, ref, mod, hooked, defined, liveout[name])
+        own = None
+        grew_floor = 0
+        for i, (use, kill, call, succ, tail, ret) in enumerate(s["nodes"]):
+            if not call:
+                continue
+            after = outs[i] | (liveout[name] if ret else 0)
+            for kind, target in call:
+                if kind == "d":
+                    t = target[len("__imp__"):] if target.startswith("__imp__") else target
+                    if t in liveout and after & ~liveout[t]:
+                        liveout[t] |= after
+                        if t not in inwork:
+                            inwork.add(t)
+                            work.append(t)
+                elif kind == "i":
+                    # What the code after an indirect call reads of the volatile registers itself (the target
+                    # preserves the others): the registers later callees read (REF) are their arguments, set
+                    # after this call, not something an unknown target hands over. (The switch fallback, kind "s",
+                    # is a jump table's out-of-range path.)
+                    if own is None:
+                        own = liveness(s, ref, mod, hooked, defined, liveout[name] & RESULT_FLOOR, False)[1]
+                    # The non-volatiles are another matter: the target must leave their ctx copy as it found it
+                    # when anything after the call may read it (a later callee's REF included), so those count
+                    # in full.
+                    after = ((own[i] | (liveout[name] & RESULT_FLOOR if ret else 0)) & ABI_MOD) | (
+                        (outs[i] | (liveout[name] if ret else 0)) & ~ABI_MOD)
+                    grew_floor |= after
+        if grew_floor & ~floor:
+            floor |= grew_floor
+            for t in liveout:
+                if floor & ~liveout[t]:
+                    liveout[t] |= floor
+                    if t not in inwork:
+                        inwork.add(t)
+                        work.append(t)
+    return liveout
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Phase 3 (per file): the rewrite.
+
+def flush(m, names):
+    return "".join(f"ctx.{r} = L_{r}; " for r in names if m >> BIT[r] & 1)
+
+
+def reload(m, names):
+    return "".join(f" L_{r} = ctx.{r};" for r in names if m >> BIT[r] & 1)
+
+
+def ctype(r):
+    if r == "lr":
+        return "uint64_t"
+    if r == "xer":
+        return "PPCXERRegister"
+    if r.startswith("cr"):
+        return "PPCCRRegister"
+    if r[0] == "v":
+        return "PPCVRegister"
+    return "PPCRegister"
+
+
+def rewrite(f, ref, mod, liveout, hooked, defined, sites=None, must=None, spkeep=None, fast=None):
+    body, n = f.body, f.n
+    if not f.used:
+        return None
+    names = [r for r in NAMES if f.used >> BIT[r] & 1]
+
+    def site(kind, target):
+        return call_ref_mod(kind, target, ref, mod, hooked, defined)
+
+    # The registers whose ctx copy this function may change: written ones it writes back at a call, and what its
+    # callees change. MOD(F) | CH: what a return writes back (when dirty).
+    ch = 0
+    for i in range(n):
+        if f.calls[i]:
+            for kind, target in f.calls[i]:
+                r, m = site(kind, target)
+                ch |= m | (f.written & (r | m))
+    # ... of which the caller may read back: LIVEOUT(F).
+    at_return = (mod[f.name] | ch) & liveout[f.name]
+    _, live_out = liveness(summarize(f), ref, mod, hooked, defined, liveout[f.name])
+
+    # Saved registers nobody gets back: not written back at a return, not read by a tail call, not read between
+    # their restore and the return. Their save and restore go (the frame slot is left as it was).
+    strip = f.pres & ~at_return
+    for i in range(n):
+        if f.calls[i] and f.tail[i]:
+            for kind, target in f.calls[i]:
+                strip &= ~site(kind, target)[0]
+                if kind == "s" or (target or "").replace("__imp__", "", 1) in CTX_IMPORTS:
+                    strip = 0
+    for i, reg in f.restore_lines.items():
+        b = 1 << BIT[reg]
+        if not strip & b:
+            continue
+        j = i + 1
+        while j < n:
+            if f.use[j] & b or f.wr[j] & b or GOTO.search(code_part(body[j])) or LABEL.match(body[j]):
+                strip &= ~b
+                break
+            if f.returns[j] or (f.calls[j] and f.tail[j]):
+                break
+            if f.calls[j]:
+                strip &= ~b
+                break
+            j += 1
+        else:
+            strip &= ~b
+    dropped = {i for i, r in f.save_lines.items() if strip >> BIT[r] & 1}
+    dropped |= {i for i, r in f.restore_lines.items() if strip >> BIT[r] & 1}
+
+    fast = fast or {}
+    own_args = fast.get(f.name, [])
+
+    def fast_of(kind, target):
+        """FASTARGS: the fast entry's argument registers for a direct call to it, else None."""
+        if kind != "d" or not target:
+            return None
+        t = target[len("__imp__"):] if target.startswith("__imp__") else target
+        return fast.get(t)
+
+    # Forward may-dirty dataflow. (FASTARGS: the fast entry's arguments are not in ctx: dirty from the start.)
+    din = [0] * (n + 1)
+    din[f.start] = mask(own_args)
+    seen = [False] * (n + 1)
+    seen[f.start] = True
+    work = [f.start]
+    while work:
+        i = work.pop()
+        if i >= n:
+            continue
+        cur = din[i] | f.wr[i]
+        if f.calls[i] and f.plain[i]:
+            kind, target = f.calls[i][0]
+            r, m = site(kind, target)
+            if f.tail[i]:
+                cur = 0
+            else:
+                fa = fast_of(kind, target)
+                cur &= ~((r & ~mask(fa)) | m) if fa else ~(r | m)
+        for s in f.succ[i]:
+            nd = din[s] | cur
+            if nd != din[s] or not seen[s]:
+                din[s] = nd
+                seen[s] = True
+                work.append(s)
+
+    def ret_poison(here, calls):
+        """PLR_CHECK=1: at a return, the GPRs/FPRs this function changed (dirty) that its callers may not read back
+        (MOD | CH, not in LIVEOUT) get a poison naming the return; a caller reading one faults at 0x5Exxxxxx (a
+        LIVEOUT mistake: the caller would have read a stale value from ctx)."""
+        if not CHECK or calls:
+            return ""
+        pm = here & (mod[f.name] | ch) & ~liveout[f.name]
+        regs = [x for x in names if x[0] in "rf" and x[1:].isdigit() and pm >> BIT[x] & 1]
+        if not regs:
+            return ""
+        sid = sites["base"] + len(sites["list"])
+        sites["list"].append(f"{sid:06X} {f.name} line {i if i < n else n} returns")
+        pv = 0x5EAD5EAD00000000 | 0x5E000000 | sid
+        return "".join(f"ctx.{x}.u64 = 0x{pv:X}ull; " for x in regs)
+
+    out = body[:f.start]
+    out.extend((f"\tPPCRegister L_{r}; L_{r}.u64 = a_{r};" if r in own_args else f"\t{ctype(r)} L_{r} = ctx.{r};")
+               for r in names)
+    sub = lambda m: "L_" + m.group(1)
+    for i in range(f.start, n):
+        line = body[i]
+        if i in dropped:
+            out.append("\t// (save/restore of a register nobody gets back: dropped)")
+            continue
+        if not (f.use[i] or f.wr[i] or f.calls[i] or f.returns[i]):
+            out.append(line)
+            continue
+        code = code_part(line)
+        comment = line[len(code):]
+        new = OCC.sub(sub, code)
+        if not seen[i]:
+            out.append(new + comment)
+            continue
+        here = din[i] | f.wr[i]
+        if f.calls[i]:
+            tail = f.tail[i]
+
+            def wrap(kind, target, text):
+                r, m = site(kind, target)
+                if kind == "t":
+                    return "{ " + flush(here, names) + text + " }"
+                if kind == "x":
+                    # ctx holds the registers the guest setjmp saved: every copy comes from it again.
+                    return "{ " + text + reload(f.used, names) + " }"
+                if kind == "s" or (target or "").replace("__imp__", "", 1) in CTX_IMPORTS:
+                    return "{ " + flush(here, names) + text + reload(m & f.used, names) + " }"
+                if tail:
+                    # What the callee reads, and what this function's return has to leave in ctx (the return
+                    # after the call writes nothing back: everything it changes is read back here).
+                    return "{ " + flush(here & (r | at_return), names) + text + reload(m & f.used, names) + " }"
+                fm = here & (r | (m & live_out[i]))
+                if must is not None and kind == "d" and not CHECK:
+                    t = target[len("__imp__"):] if target.startswith("__imp__") else target
+                    if t in defined and t not in hooked and must.get(t):
+                        fm &= ~(must[t] & ~r)
+                fa = fast_of(kind, target) if not tail else None
+                if fa:
+                    t = target[len("__imp__"):] if target.startswith("__imp__") else target
+                    fm &= ~mask(fa)
+                    text = (f"__fast__{t}(ctx, base" +
+                            "".join(f", L_{x}.u64" if x in names else f", ctx.{x}.u64" for x in fa) + ");")
+                back = m & f.used
+                if spkeep and kind == "d" and not CHECK:
+                    t = target[len("__imp__"):] if target.startswith("__imp__") else target
+                    if t in defined and t not in hooked and t in spkeep:
+                        back &= ~(1 << BIT["r1"])
+                if not CHECK:
+                    return "{ " + flush(fm, names) + text + reload(back, names) + " }"
+                # PLR_CHECK=1: the registers not read back must come back unchanged (MOD), and the dirty ones not
+                # written back get a poison value the callee must not use (REF).
+                # Each site has a number (sites[0], the file's base, plus a count): the poison's low word is
+                # 0x5E000000 | number, so a fault on a poisoned address names the site (PLR_MAP lists them).
+                sid = sites["base"] + len(sites["list"])
+                sites["list"].append(f"{sid:06X} {f.name} line {i} calls {target or 'bctrl'}")
+                gp = [x for x in names if x[0] in "rf" and x[1:].isdigit()]
+                poison = [x for x in gp if (here & ~fm) >> BIT[x] & 1]
+                keep = [x for x in gp if not (m >> BIT[x] & 1) and live_out[i] >> BIT[x] & 1]
+                pv = 0x5EAD5EAD00000000 | 0x5E000000 | sid
+                # (and put back after the call: the poison is a change of ctx this function's analysis does not
+                # know about, and a caller trusting ctx to be unchanged there would read it)
+                pre = ""
+                if poison:
+                    pre = "const uint64_t pz_[] = {" + ", ".join(f"ctx.{x}.u64" for x in poison) + "}; "
+                pre += "".join(f"ctx.{x}.u64 = 0x{pv:X}ull; " for x in poison)
+                if keep:
+                    pre += "const uint64_t chk_[] = {" + ", ".join(f"ctx.{x}.u64" for x in keep) + "}; "
+                cond = " || ".join(f"ctx.{x}.u64 != chk_[{k}]" for k, x in enumerate(keep))
+                post = (f" if (__builtin_expect({cond}, 0)) mp3_regcheck_fail(__func__, \"{target or 'bctrl'}\", "
+                        f"0x{sid:X}, \"{' '.join(keep)}\", chk_, &ctx);" if keep else "")
+                unpoison = "".join(f" ctx.{x}.u64 = pz_[{k}];" for k, x in enumerate(poison))
+                return "{ " + flush(fm, names) + pre + text + post + unpoison + reload(m & f.used, names) + " }"
+
+            spans = find_indirect(new)
+            kinds = [k for k, _ in f.calls[i] if k in ("i", "s")]
+            for (a, b), k in reversed(list(zip(spans, kinds))):
+                new = new[:a] + wrap(k, None, new[a:b]) + new[b:]
+            new = CALL.sub(lambda m: wrap("x" if m.group(1) == FIBER else "d", m.group(1), m.group(0)), new)
+            new = TRAP.sub(lambda m: wrap("t", None, m.group(0)), new)
+        if f.returns[i]:
+            fm = here & at_return
+            pz = ret_poison(here, f.calls[i]) if CHECK else ""
+            if fm or pz:
+                new = new.replace("return;", "{ " + flush(fm, names) + pz + "return; }")
+        out.append(new + comment)
+    if seen[n] and (din[n] & at_return or CHECK):
+        tail = flush(din[n] & at_return, names) + ret_poison(din[n], None)
+        if tail:
+            out.append("\t" + tail.rstrip())
+    return out
+
+
+def phase3(args):
+    path, helpers, ref, mod, liveout, hooked, defined, must, spkeep, fast = args
+    lines, funcs = parse_file(path, helpers)
+    m = re.search(r"_recomp\.(\d+)\.cpp$", path)  # vig8: vig8_recomp.N.cpp
+    sites = {"base": (int(m.group(1)) if m else 255) << 16, "list": []}
+    out = []
+    last = 0
+    done = skipped = 0
+    fast_here = 0
+    for name, a, b, f in funcs:
+        new = None
+        if f is not None and f.ok:
+            new = rewrite(f, ref, mod, liveout, hooked, defined, sites, must, spkeep, fast)
+            done += 1
+        elif f is not None:
+            skipped += 1
+        args_f = fast.get(name) if new is not None else None
+        if args_f:
+            fast_here += 1
+            out.extend(lines[last:a])
+            params = "".join(f", uint64_t a_{x}" for x in args_f)
+            out.append(f'extern "C" void __fast__{name}([[maybe_unused]] PPCContext& __restrict ctx, uint8_t* base{params}) {{')
+            out.extend(new)
+            out.append("}")
+            out.append(f"DEFINE_REX_FUNC({name}) {{")
+            out.append("\tREX_FUNC_PROLOGUE();")
+            out.append(f"\t__fast__{name}(ctx, base" + "".join(f", ctx.{x}.u64" for x in args_f) + ");")
+            last = b  # its closing brace comes next
+            continue
+        out.extend(lines[last:a + 1])
+        out.extend(new if new is not None else lines[a + 1:b])
+        last = b
+    out.extend(lines[last:])
+    if fast:
+        for k, l in enumerate(out):
+            if l.startswith("#include"):
+                out.insert(k + 1, '#include "vig8_fast.h"')
+                break
+    open(path, "w", encoding="utf-8", errors="surrogateescape").write("\n".join(out))
+    return done, skipped, sites["list"]
+
+
+def main(argv):
+    if "--" not in argv:
+        sys.exit(__doc__)
+    i = argv.index("--")
+    helpers = load_helpers(argv[0])
+    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+    from patch_inline_calls import defined_names, hooked_names
+    files = argv[i + 1:]
+    # The functions the sources name: hooked (a strong symbol of that name replaces the alias) or called from native
+    # code (__imp__<name>). Either way native code is on one side of the call.
+    hooked = hooked_names(argv[1:i], defined_names(files))
+    if any("L_r1" in open(p, encoding="utf-8", errors="surrogateescape").read() for p in files[:1]):
+        print("patch_local_regs: already applied")
+        return 0
+    with ProcessPoolExecutor(max_workers=os.cpu_count()) as ex:
+        summ = {}
+        for part in ex.map(phase1, [(p, helpers) for p in files]):
+            summ.update(part)
+        ref, mod = fixpoint(summ, hooked)
+        defined = set(summ)
+        native = hooked
+        liveout = fixpoint_liveout(summ, ref, mod, hooked, defined, native)
+        must = fixpoint_must(summ, hooked) if os.environ.get("PLR_MUST", "1") == "1" else {}
+        nmust = sum(1 for v in must.values() if v)
+        fast = {}
+        if FASTARGS:
+            # Every function any of the port's other native code names (Renut's D3D hooks: mp3/renut) keeps its ctx
+            # entry for every caller: its sub_ symbol may be replaced by native code.
+            named = set()
+            here = os.path.dirname(os.path.abspath(__file__))
+            for d in [os.path.join(here, "..", "renut")] + os.environ.get("PLR_EXTRA_HOOK_DIRS", "").split(":"):
+                if not d or not os.path.isdir(d):
+                    continue
+                for root, _, fs in os.walk(d):
+                    for fn in fs:
+                        if fn.endswith((".cpp", ".h", ".hpp", ".inc", ".c")):
+                            text = open(os.path.join(root, fn), encoding="utf-8", errors="replace").read()
+                            named.update(re.findall(r"\bsub_[0-9A-F]{8}\b", text))
+            print(f"patch_local_regs: FASTARGS: {len(named)} functions named in native sources keep the ctx entry",
+                  file=sys.stderr)
+            for name, s in summ.items():
+                if s is None or name in hooked or name in named:
+                    continue
+                a = [x for x in FAST_GPRS if ref[name] >> BIT[x] & 1 and s["used"] >> BIT[x] & 1]
+                if a:
+                    fast[name] = a
+            hdr = os.path.join(os.path.dirname(os.path.abspath(files[0])), "vig8_fast.h")
+            with open(hdr, "w") as fo:
+                fo.write("// Written by patch_local_regs.py (FASTARGS): the guest functions' fast entries.\n#pragma once\n")
+                for name, a in sorted(fast.items()):
+                    fo.write(f'extern "C" void __fast__{name}(PPCContext& __restrict, uint8_t*' +
+                             ", uint64_t" * len(a) + ");\n")
+            print(f"patch_local_regs: FASTARGS: {len(fast)} functions take their arguments by value", file=sys.stderr)
+        spkeep = ({k for k, s in summ.items() if s is not None and s.get("sp_keep")}
+                  if os.environ.get("PLR_SPKEEP", "1") == "1" else set())
+        print(f"patch_local_regs: SPKEEP: {len(spkeep)} functions give r1 back as they got it", file=sys.stderr)
+        print(f"patch_local_regs: MUST: {nmust} functions replace registers on every path", file=sys.stderr)
+        if os.environ.get("PLR_DUMP"):
+            import pickle
+            pickle.dump({"ref": ref, "mod": mod, "liveout": liveout,
+                         "pres": {k: v["pres"] for k, v in summ.items() if v}},
+                        open(os.environ["PLR_DUMP"], "wb"))
+        done = skipped = 0
+        site_list = []
+        for d, s, sl in ex.map(phase3, [(p, helpers, ref, mod, liveout, hooked, defined, must, spkeep, fast) for p in files]):
+            done += d
+            skipped += s
+            site_list.extend(sl)
+        if CHECK and os.environ.get("PLR_MAP"):
+            with open(os.environ["PLR_MAP"], "w") as fo:
+                fo.write("\n".join(site_list) + "\n")
+    nv_ref = sum(1 for k, v in ref.items() if summ.get(k) and v & NONVOL & ~mask(["r1", "r13"]))
+    if os.environ.get("PLR_DEBUG"):
+        odd = {k: v & ~ABI_REF for k, v in ref.items() if summ.get(k) and v & ~ABI_REF}
+        with open(os.environ["PLR_DEBUG"], "w") as fo:
+            for k, v in sorted(odd.items()):
+                fo.write(k + " " + " ".join(r for r in NAMES if v >> BIT[r] & 1) + "\n")
+    print(f"patch_local_regs: {done} functions with registers in locals, {skipped} left as they were; "
+          f"{nv_ref} functions read a caller's non-volatile register")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
diff --git a/project/tools/patch_phys_base.py b/project/tools/patch_phys_base.py
new file mode 100755
index 0000000..31bb27e
--- /dev/null
+++ b/project/tools/patch_phys_base.py
@@ -0,0 +1,33 @@
+#!/usr/bin/env python3
+"""mp3-ps4 (v00.47): the guest's register + displacement accesses take the 0xE0000000 heap's host offset from the
+base register: REX_LOAD_U32_B(L_r31.u32, 448) for REX_LOAD_U32(L_r31.u32 + 448), so the compiler checks a pointer
+once for every access through it instead of once per access.
+
+On the PS4 the 0xE0000000 heap sits 4 KiB further in host memory (REX_PHYS_HOST_OFFSET, make_ps4_pch.py a), and the
+check was four x86 instructions on every guest load and store (xor, cmp, setae, shl: ~13 % of the converted code,
+and registers spilled to hold the offsets): the register + displacement form is ~707,000 of the game's ~805,000
+accesses (the stack's, r1, are already REX_SLOAD/REX_SSTORE without it: patch_stack_access.py). A base register and
+the address it reaches lie on the same side of 0xE0000000 unless an object straddles two of the console's views,
+which its memory map does not allow (the 0xC0000000 view ends there; the 0xE0000000 one starts at physical 0x1000);
+the one constant 0xE0000000 in the game (lis r8,-8192 in sub_823A2F28) only takes part in a comparison. Indexed
+(register + register) accesses keep the check on the whole address. The macros: make_ps4_pch.py e.
+
+Run after patch_local_regs.py (it reads the generated text). Idempotent. Usage: patch_phys_base.py <generated .cpp>
+"""
+import re
+import sys
+
+PATTERN = re.compile(r"REX_(LOAD|STORE)_U(8|16|32|64)\((L_r\d+\.u32) \+ (-?\d+)([,)])")
+
+files = sites = 0
+for path in sys.argv[1:]:
+    text = open(path, encoding="utf-8").read()
+    new, n = PATTERN.subn(lambda m: f"REX_{m.group(1)}_U{m.group(2)}_B({m.group(3)}, {m.group(4)}{m.group(5)}", text)
+    if not n:
+        continue
+    with open(path, "w", encoding="utf-8", newline="\n") as f:
+        f.write(new)
+    files += 1
+    sites += n
+print(f"patch_phys_base: {sites} register + displacement accesses take the heap offset from their base register "
+      f"in {files} files")
diff --git a/project/tools/patch_stack_access.py b/project/tools/patch_stack_access.py
new file mode 100755
index 0000000..8d83387
--- /dev/null
+++ b/project/tools/patch_stack_access.py
@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+"""Guest stack accesses without volatile (make_nx_pch.py, point 6).
+
+REX_LOAD_*/REX_STORE_* go through volatile pointers, so the compiler keeps every guest memory access as written: a
+local spilled to the guest stack and read back at once is still a store and a load, and the register save/restore
+helpers cannot pair their stores. The guest stack (r1) belongs to one thread, so accesses at ctx.r1.u32 (and, inside
+the __savefpr_/__restfpr_/__savevmx_/__restvmx_ helpers, at ctx.r12.u32, which points into the caller's frame there)
+become REX_SLOAD_*/REX_SSTORE_*: plain, alias-safe accesses (memcpy) the compiler may keep in registers or combine.
+
+Usage: patch_stack_access.py generated/default/*.cpp   (idempotent)
+"""
+
+import re
+import sys
+
+STACK = re.compile(r"\bREX_(LOAD|STORE)_U(8|16|32|64)\(ctx\.r1\.u32\b")
+HELPER_R12 = re.compile(r"\bREX_(LOAD|STORE)_U(8|16|32|64)\(ctx\.r12\.u32\b")
+HELPER = re.compile(r"^DEFINE_REX_FUNC\(__(save|rest)(fpr|vmx)_\d+\)")
+
+
+def patch(path):
+    with open(path, encoding="utf-8", errors="surrogateescape") as f:
+        lines = f.readlines()
+    changed = 0
+    in_helper = False
+    for i, line in enumerate(lines):
+        if line.startswith("DEFINE_REX_FUNC("):
+            in_helper = bool(HELPER.match(line))
+        new, n = STACK.subn(r"REX_S\1_U\2(ctx.r1.u32", line)
+        if in_helper:
+            new, m = HELPER_R12.subn(r"REX_S\1_U\2(ctx.r12.u32", new)
+            n += m
+        if n:
+            lines[i] = new
+            changed += n
+    if changed:
+        with open(path, "w", encoding="utf-8", errors="surrogateescape") as f:
+            f.writelines(lines)
+    return changed
+
+
+def main(paths):
+    total = sum(patch(p) for p in paths)
+    print(f"patch_stack_access: {total} guest stack accesses without volatile")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
diff --git a/project/tools/patch_vmx_exact.py b/project/tools/patch_vmx_exact.py
new file mode 100755
index 0000000..5df001d
--- /dev/null
+++ b/project/tools/patch_vmx_exact.py
@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+"""Vector instructions of ReXGlue v0.10.0's code made to compute what the console computes.
+
+- vmaddfp / vnmsubfp: the codegen writes a*b + c and -(a*b - c) with two roundings; the console's VMX fuses them
+  (one rounding). Liberty Recompiled and this repository's Vulkan build (source/) build GTA IV with the fused form
+  (REX_FUSED_VMADDFP, simde's fmadd / fnmadd: fmla / fmls on the Switch). Written as REX_VMADDFP / REX_VNMSUBFP,
+  defined in the PCH (tools/make_nx_pch.py, point 10).
+- vpkuwus: the codegen writes it as eight scalar stores into vD, so when vD is also vA or vB a lane is overwritten
+  before it is read. One vector expression instead (Liberty Recompiled's fix): clamp to 0xFFFF, then pack.
+
+usage: patch_vmx_exact.py <generated .cpp>...
+"""
+import re
+import sys
+
+LOAD = r"simde_mm_load_ps\(([A-Za-z_0-9.]+)\)"
+MADD = re.compile(r"simde_mm_add_ps\(simde_mm_mul_ps\(%s, %s\), %s\)" % (LOAD, LOAD, LOAD))
+NMSUB = re.compile(
+    r"simde_mm_xor_ps\(simde_mm_sub_ps\(simde_mm_mul_ps\(%s, %s\), %s\), "
+    r"simde_mm_castsi128_ps\(simde_mm_set1_epi32\(int\(0x80000000\)\)\)\)" % (LOAD, LOAD, LOAD))
+# Eight lines: vD.u16[7-i] from vA.u32[3-i] and vD.u16[3-i] from vB.u32[3-i], i = 0..3.
+LANE = r"\t(?P<d{n}>[A-Za-z_0-9.]+)\.u16\[{h}\] = (?P<s{n}>[A-Za-z_0-9.]+)\.u32\[{w}\] > 0xFFFF \? 0xFFFF : \(uint16_t\)(?P=s{n})\.u32\[{w}\];\n"
+PKUWUS = re.compile("".join(LANE.format(n=2 * i, h=7 - i, w=3 - i) + LANE.format(n=2 * i + 1, h=3 - i, w=3 - i)
+                            for i in range(4)))
+
+
+def pkuwus(m):
+    d = {m.group("d%d" % k) for k in range(8)}
+    a = {m.group("s%d" % k) for k in range(0, 8, 2)}
+    b = {m.group("s%d" % k) for k in range(1, 8, 2)}
+    if len(d) != 1 or len(a) != 1 or len(b) != 1:
+        return m.group(0)
+    d, a, b = d.pop(), a.pop(), b.pop()
+    return ("\tsimde_mm_store_si128((simde__m128i*){d}.u16, simde_mm_packus_epi32("
+            "simde_mm_min_epu32(simde_mm_load_si128((simde__m128i*){b}.u32), simde_mm_set1_epi32(0xFFFF)), "
+            "simde_mm_min_epu32(simde_mm_load_si128((simde__m128i*){a}.u32), simde_mm_set1_epi32(0xFFFF))));\n"
+            ).format(d=d, a=a, b=b)
+
+
+totals = [0, 0, 0]
+for path in sys.argv[1:]:
+    text = open(path, encoding="utf-8").read()
+    text, n1 = MADD.subn(r"REX_VMADDFP(simde_mm_load_ps(\1), simde_mm_load_ps(\2), simde_mm_load_ps(\3))", text)
+    text, n2 = NMSUB.subn(r"REX_VNMSUBFP(simde_mm_load_ps(\1), simde_mm_load_ps(\2), simde_mm_load_ps(\3))", text)
+    text, n3 = PKUWUS.subn(pkuwus, text)
+    if n1 or n2 or n3:
+        open(path, "w", encoding="utf-8").write(text)
+    totals = [totals[0] + n1, totals[1] + n2, totals[2] + n3]
+print("patch_vmx_exact: %d vmaddfp, %d vnmsubfp fused; %d vpkuwus as one expression" % tuple(totals))
diff --git a/project/tools/prepare_tree.py b/project/tools/prepare_tree.py
new file mode 100644
index 0000000..a10e252
--- /dev/null
+++ b/project/tools/prepare_tree.py
@@ -0,0 +1,37 @@
+#!/usr/bin/env python3
+"""Mirror the generated code (codegen/generated/default/) for the PS4 build (from mp3-nx's tools/prepare_tree.py).
+
+The generated files include "vig8_pch.h" with quotes, which always finds the copy next to the includer first. So the
+PS4 build compiles a mirror of the tree made of symlinks, where only the PCH is replaced by the PS4 one
+(make_ps4_pch.py).
+
+Usage: prepare_tree.py <generated/default> <out_dir> [PCH script, default make_ps4_pch.py] [PCH name, vig8_pch.h]
+"""
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+src = Path(sys.argv[1]).resolve()
+out = Path(sys.argv[2]).resolve()
+here = Path(__file__).resolve().parent
+pch_tool = Path(sys.argv[3]) if len(sys.argv) > 3 else here / "make_ps4_pch.py"
+PCH = sys.argv[4] if len(sys.argv) > 4 else "vig8_pch.h"
+
+n = 0
+for root, dirs, files in os.walk(src):
+    rel = Path(root).relative_to(src)
+    (out / rel).mkdir(parents=True, exist_ok=True)
+    for f in files:
+        if rel == Path(".") and f == PCH:
+            continue
+        link = out / rel / f
+        target = Path(root) / f
+        if link.is_symlink() or link.exists():
+            if link.is_symlink() and Path(os.readlink(link)) == target:
+                continue
+            link.unlink()
+        link.symlink_to(target)
+        n += 1
+subprocess.check_call([sys.executable, "-I", str(pch_tool), str(src / PCH), str(out / PCH)])
+print(f"{n} links in {out}")
