+// vig8-ps4 - the L3+R3 quick menu and the frame counter (vig8_ps4_menu.cpp).
+
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <string>
+
+struct ImFontAtlas;
+
+namespace rex::ui {
+class ImGuiDrawer;
+class WindowedAppContext;
+}  // namespace rex::ui
+
+namespace vig8::menu {
+
+// ReXApp::OnConfigureFonts: the menu's typefaces (Lato), baked at the sizes it draws with.
+void AddFonts(ImFontAtlas* atlas);
+
+// ReXApp::OnCreateDialogs, on the UI thread: from here L3+R3 opens the menu. Its settings are saved to 'config'.
+void Attach(rex::ui::WindowedAppContext& context, rex::ui::ImGuiDrawer* drawer, std::filesystem::path config);
+
+// At each of the game's swaps (VdSwap, the game's thread): a frame for the counter, and L3+R3.
+void NoteSwap();
+
+// An achievement's unlock pop-up (any thread; queued, shown one after another).
+void ShowAchievement(const std::string& name, uint32_t gamerscore);
