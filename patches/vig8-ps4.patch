diff --git a/project/ps4/CMakeLists.txt b/project/ps4/CMakeLists.txt
new file mode 100644
index 0000000..a03ff74
--- /dev/null
+++ b/project/ps4/CMakeLists.txt
@@ -0,0 +1,113 @@
+# vig8-ps4 - Vigilante 8 Arcade (Xbox 360 XBLA, 584108A8) on the PS4 (ps4-kit: clang 21, OpenOrbis, x86-64 Jaguar).
+#
+# The MGR/MP3 ports' way (iHaiDeeZ/MGR-PS4, iHaiDeeZ/MP3-PS4): the game's PowerPC code recompiled to C++ by ReXGlue
+# v0.10.0's code generator and built for x86-64, the runtime being MP3's PS4 SDK (rexglue-sdk-nx + the PS4 layer), the
+# game's command ring drawn by the SDK's own Xenos emulation on its Vulkan back end, on ps4-kit's statically linked
+# RADV. One eboot.
+#
+# Configure (the port's scripts/build-vig8.sh app does it):
+#   ps4_cmake -S project/ps4 -B <build> -G Ninja -DCMAKE_BUILD_TYPE=Release \
+#     -DCMAKE_PROJECT_vig8_INCLUDE=$PS4_KIT/ps4-kit.cmake -DPS4_KIT_NETFS=OFF \
+#     -DREXSDK_DIR=<the PS4 SDK> -DVIG8_CODEGEN_DIR=<codegen output> -DREXGLUE_PLATFORM_PS4=ON -DREXGLUE_USE_VULKAN=ON
+
+cmake_minimum_required(VERSION 3.25)
+project(vig8 LANGUAGES C CXX)
+
+set(CMAKE_CXX_STANDARD 23)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+
+if(NOT REXGLUE_PLATFORM_PS4)
+    message(FATAL_ERROR "project/ps4: the PS4 build (-DREXGLUE_PLATFORM_PS4=ON, ps4-kit's toolchain)")
+endif()
+
+get_filename_component(VIG8_DIR "${CMAKE_CURRENT_SOURCE_DIR}/.." ABSOLUTE)
+
+set(VIG8_CODEGEN_DIR "" CACHE PATH "The codegen's output folder (holds generated/default/)")
+set(VIG8_GENERATED "${VIG8_CODEGEN_DIR}/generated/default")
+if(NOT EXISTS "${VIG8_GENERATED}/sources.cmake")
+    message(FATAL_ERROR
+        "VIG8_CODEGEN_DIR must point at the codegen's output "
+        "(no generated/default/sources.cmake under '${VIG8_CODEGEN_DIR}')")
+endif()
+
+set(REXSDK_DIR "" CACHE PATH "Path to the PS4 SDK (rexglue-sdk-nx + the PS4 layer)")
+if(NOT REXSDK_DIR)
+    message(FATAL_ERROR "REXSDK_DIR: the PS4 SDK's source tree")
+endif()
+add_subdirectory("${REXSDK_DIR}" rexglue-sdk)
+message(STATUS "vig8: ReXGlue SDK from ${REXSDK_DIR}")
+
+# The mirror of the generated tree with the PS4 PCH (tools/make_ps4_pch.py).
+find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
+set(VIG8_TREE "${CMAKE_BINARY_DIR}/generated_ps4")
+execute_process(
+    COMMAND "${Python3_EXECUTABLE}" -I "${VIG8_DIR}/tools/prepare_tree.py"
+            "${VIG8_GENERATED}" "${VIG8_TREE}" "${VIG8_DIR}/tools/make_ps4_pch.py" vig8_pch.h
+    RESULT_VARIABLE _vig8_tree_rc)
+if(NOT _vig8_tree_rc EQUAL 0)
+    message(FATAL_ERROR "vig8: tools/prepare_tree.py failed (${_vig8_tree_rc})")
+endif()
+set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
+    "${VIG8_GENERATED}/vig8_pch.h"
+    "${VIG8_GENERATED}/sources.cmake"
+    "${VIG8_DIR}/tools/make_ps4_pch.py"
+    "${VIG8_DIR}/tools/prepare_tree.py")
+
+# generated/default/sources.cmake: the support units and the recompiled ones. CMAKE_CURRENT_LIST_DIR there is the mirror.
+include("${VIG8_TREE}/sources.cmake")
+set(VIG8_GUEST_SOURCES ${GENERATED_SOURCES})
+# No debug info for the generated units, the guest's floating point unfused (the Jaguar has no FMA unit), no strict
+# aliasing (guest memory is read through any type), a section per function (for a later hot-function order), as
+# MP3's port builds its generated code.
+set(VIG8_RECOMP_OPTIONS -g0 -ffp-contract=off -fno-strict-aliasing -ffunction-sections)
+# The registration unit is one long function of SetFunction calls, run once at startup: -O1 and no PCH.
+set_source_files_properties("${VIG8_TREE}/vig8_register.cpp" PROPERTIES
+    COMPILE_OPTIONS "-O1"
+    SKIP_PRECOMPILE_HEADERS ON)
+list(LENGTH VIG8_GUEST_SOURCES _vig8_n)
+message(STATUS "vig8: ${_vig8_n} recompiled sources from ${VIG8_GENERATED}")
+
+add_executable(vig8
+    main_ps4.cpp
+    vig8_ps4.cpp
+    vig8_ps4_game.cpp
+    vig8_ps4_menu.cpp
+    vig8_ps4_achievements.cpp
+)
+
+add_library(vig8_recomp OBJECT ${VIG8_GUEST_SOURCES})
+target_include_directories(vig8_recomp PRIVATE "${VIG8_TREE}")
+target_link_libraries(vig8_recomp PRIVATE rex::runtime)
+rexglue_apply_target_settings(vig8_recomp)
+target_precompile_headers(vig8_recomp PRIVATE "${VIG8_TREE}/vig8_pch.h")
+target_compile_options(vig8_recomp PRIVATE ${VIG8_RECOMP_OPTIONS})
+target_link_libraries(vig8 PRIVATE vig8_recomp)
+target_include_directories(vig8 PRIVATE "${VIG8_TREE}" "${CMAKE_CURRENT_SOURCE_DIR}")
+target_link_libraries(vig8 PRIVATE rex::runtime)
+target_compile_options(vig8 PRIVATE -ffp-contract=off -fno-strict-aliasing)
+
+# The version and the commit it was built from, in the first lines of the log.
+set(VIG8_VERSION "00.00" CACHE STRING "Version in the log")
+execute_process(COMMAND git rev-parse --short=10 HEAD WORKING_DIRECTORY "${VIG8_DIR}"
+                OUTPUT_VARIABLE VIG8_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
+if(NOT VIG8_COMMIT)
+    set(VIG8_COMMIT "unknown")
+endif()
+set_property(SOURCE ${CMAKE_CURRENT_SOURCE_DIR}/vig8_ps4.cpp ${CMAKE_CURRENT_SOURCE_DIR}/vig8_ps4_menu.cpp APPEND
+             PROPERTY COMPILE_DEFINITIONS VIG8_VERSION="${VIG8_VERSION}" VIG8_COMMIT="${VIG8_COMMIT}")
+# The quick menu's Lato fonts are #embed'ed (fonts/, SIL Open Font License: fonts/LICENSE-Lato.txt; MP3-PS4's).
+set_property(SOURCE ${CMAKE_CURRENT_SOURCE_DIR}/vig8_ps4_menu.cpp APPEND PROPERTY OBJECT_DEPENDS
+             ${CMAKE_CURRENT_SOURCE_DIR}/fonts/Lato-Regular.ttf ${CMAKE_CURRENT_SOURCE_DIR}/fonts/Lato-Black.ttf)
+
+# The runtime, ReXApp and the PS4 entry point, with the Xenos GPU (Vulkan) linked whole; RADV and the kit's WSI; the
+# eboot.
+rexglue_configure_target(vig8 GPU_PLUGINS xenos)
+ps4_kit_link_mesa(vig8)
+ps4_kit_app(vig8)
+# The kit's DNS wrap (ps4_net.cpp) without its SMB/NFS shares (PS4_KIT_NETFS off): the libc member has to be pulled in
+# by name, or __real_getaddrinfo stays an import create-fself refuses (ConkerLR's, MGR's and MP3's fix).
+target_link_options(vig8 PRIVATE --undefined=getaddrinfo)
+# The same for malloc_usable_size, which the kit now wraps too (ps4-kit.cmake PS4_KIT_WRAPS): nothing in this eboot
+# pulls libc's member in, so the wrapped name stayed an undefined import and create-fself refused it ("missing module
+# for symbol (malloc_usable_size)", v00.01's first link).
+target_link_options(vig8 PRIVATE --undefined=malloc_usable_size)
