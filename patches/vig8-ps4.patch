@@ -0,0 +1,36 @@
+// vig8-ps4 - the game's achievements, in the quick menu and as pop-ups (vig8_ps4_achievements.cpp).
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace rex {
+class Runtime;
+}
+
+namespace vig8::achievements {
+
+struct Entry {
+  uint32_t id = 0;
+  std::string name;
+  std::string description;         // what it was for (shown once unlocked)
+  std::string locked_description;  // what to do (shown while locked; may be empty)
+  uint32_t gamerscore = 0;
+  bool secret = false;             // not shown while locked (the game's "show unachieved" flag clear)
+  bool unlocked = false;
+  uint64_t filetime = 0;           // when (Windows FILETIME, UTC)
+};
+
+// OnPreLaunchModule: listens to the SDK's achievement manager (its catalog comes from the game's own data, its unlocks
+// are saved under the user data folder) and turns the SDK's own notification off for the menu's pop-up.
+void Install(rex::Runtime& runtime);
+
+// The game's achievements in its order, with their unlock state (any thread).
+std::vector<Entry> List();
+
+// "2026-11-24" for an unlock time.
+std::string DateText(uint64_t filetime);
+
+}  // namespace vig8::achievements
diff --git a/project/ps4/vig8_ps4_app.h b/project/ps4/vig8_ps4_app.h
new file mode 100644
index 0000000..06e8bad
--- /dev/null
+++ b/project/ps4/vig8_ps4_app.h
@@ -0,0 +1,100 @@
+// vig8-ps4 - Vigilante 8 Arcade (Xbox 360 XBLA) on the PS4: the app.
+//
+// The game's files (the unpacked XBLA package: default.xex, data/*.ib, *.ibz ...) are read from game/ inside the
+// package (/app0/game, the one-file package scripts/build-vig8.sh pkg makes), else from /data/V8A/game. The High
+// Octane Pack DLC comes in the package too, as /app0/content in the SDK's installed-content layout
+// (content_marketplace_root). /data/V8A is the app's folder (the SDK's executable and user folder on the PS4): the
+// settings file vig8.toml, the logs, the saves (the content root), the freeze report.
+//
+// What differs from sp00nznet/vig8's Windows build: the GPU is the SDK's Xenos emulation on its Vulkan back end on
+// ps4-kit's RADV (not D3D12), sound through sceAudioOut, the pad through scePad (the SDK's PS4 back ends); no window,
+// no keyboard, no F3/F4 overlays; no System Link yet.
+
+#pragma once
+
+#include <rex/cvar.h>
+#include <rex/filesystem.h>
+#include <rex/logging.h>
+#include <rex/rex_app.h>
+#include <rex/runtime.h>
+#include <rex/system.h>
+
+#include <cstdlib>
+#include <filesystem>
+#include <memory>
+#include <string>
+#include <system_error>
+
+#include <ps4_kit.h>
+
+#include "vig8_ps4.h"
+#include "vig8_ps4_menu.h"
+
+class Vig8App : public rex::ReXApp {
+ public:
+  using rex::ReXApp::ReXApp;
+
+  static std::unique_ptr<rex::ui::WindowedApp> Create(rex::ui::WindowedAppContext& ctx) {
+    return std::unique_ptr<Vig8App>(new Vig8App(ctx, "vig8", PPCImageConfig));
+  }
+
+ protected:
+  // The SDK's Xenos GPU (Vulkan back end), linked into the eboot, and the port's defaults for SDK settings (each only
+  // while the setting still has the SDK's value, so vig8.toml wins).
+  void OnPreSetup(rex::RuntimeConfig& config) override {
+    if (config.gpu_plugin.empty()) config.gpu_plugin = "xenos";
+    vig8::ps4::ApplyDefaults();
+  }
+
+  // game_data_root is the folder with default.xex (ConstructRuntime checks it).
+  void OnConfigurePaths(rex::PathConfig& paths) override {
+    if (!paths.game_data_root.empty()) return;
+    const std::string flag = REXCVAR_GET(vig8_game);
+    if (!flag.empty()) {
+      paths.game_data_root = flag;
+      return;
+    }
+    if (const auto packaged = PackagedFolder("game", "default.xex"); !packaged.empty()) {
+      paths.game_data_root = packaged;
+      return;
+    }
+    paths.game_data_root = rex::filesystem::GetExecutableFolder() / "game";
+  }
+
+  void OnPostInitLogging() override { vig8::ps4::LogSystem(); }
+
+  // The L3+R3 quick menu and the frame counter (vig8_ps4_menu.cpp); its settings go to the file ReXApp loads
+  // (/data/V8A/vig8.toml).
+  void OnConfigureFonts(ImFontAtlas* atlas) override { vig8::menu::AddFonts(atlas); }
+  void OnCreateDialogs(rex::ui::ImGuiDrawer* drawer) override {
+    vig8::menu::Attach(app_context(), drawer, rex::filesystem::GetExecutableFolder() / "vig8.toml");
+  }
+
+  void OnLoadXexImage(std::string& xex_image) override {
+    std::error_code ec;
+    const auto root = game_data_root();
+    if (!std::filesystem::is_regular_file(root / "default.xex", ec)) {
+      Fail("Vigilante 8 Arcade: default.xex is missing from " + root.string() +
+           ". Install the package that holds the game, or copy your unpacked XBLA package to /data/V8A/game.");
+    }
+    REXLOG_INFO("vig8: game at {}; loading {}", root.string(), xex_image);
+  }
+
+  void OnPreLaunchModule() override { vig8::ps4::Install(*runtime()); }
+
+ private:
+  // name/ inside the package when it holds marker: before any copy in /data/V8A.
+  static std::filesystem::path PackagedFolder(const char* name, const char* marker) {
+    std::error_code ec;
+    const std::filesystem::path folder = std::filesystem::path("/app0") / name;
+    if (std::filesystem::is_regular_file(folder / marker, ec)) return folder;
+    return {};
+  }
+
+  [[noreturn]] static void Fail(const std::string& msg) {
+    REXLOG_ERROR("{}", msg);
+    rex::ShowSimpleMessageBox(rex::SimpleMessageBoxType::Error, msg);
+    rex::FlushLogging();
+    std::_Exit(1);
+  }
+};
diff --git a/project/ps4/vig8_ps4_game.cpp b/project/ps4/vig8_ps4_game.cpp
new file mode 100644
index 0000000..83d3fe4
--- /dev/null
+++ b/project/ps4/vig8_ps4_game.cpp
@@ -0,0 +1,87 @@
+// vig8-ps4 - overrides of recompiled game functions (from sp00nznet/vig8's project/src/stubs.cpp, MIT).
+//
+// Each REX_EXTERN(sub_XXXXXXXX) here replaces the generated weak definition at link time; the original stays callable
+// as __imp__sub_XXXXXXXX. Options are cvars, saved in /data/V8A/vig8.toml.
+//
+// Not here yet from stubs.cpp: the overrides of SDK kernel imports (four-player sign-in, Live privileges, the quit
+// guard): the PS4 build links the SDK's runtime whole, so a second definition of an __imp__Xam* export would clash.
+// Single player needs none of them.
+
+#include "vig8_pch.h"
+#include "vig8_init.h"
+
+#include <atomic>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+REXCVAR_DEFINE_BOOL(unlock_all_cars, false, "Vig8", "Unlock every vehicle (restart the game after changing)");
+REXCVAR_DECLARE(int32_t, vig8_antialiasing);  // vig8_ps4.cpp
+
+// ============================================================================
+// Road patch subdivision work stack (v00.08)
+// ============================================================================
+// project/tools/patch_game_fixes.py: sub_8211F3B8's work stack of road sub-patches has 32 entries and no depth limit;
+// in v00.07 an endless subdivision ran it through the main thread's guest stack top and ended the game. The generated
+// code now pushes only while an entry fits and calls this when one does not (the sub-patch is left out).
+extern "C" void vig8_subdivision_stack_full(uint32_t guest_r1) {
+  static std::atomic<uint32_t> count{0};
+  const uint32_t n = count.fetch_add(1, std::memory_order_relaxed) + 1;
+  if (n == 1 || n % 100 == 0) {
+    REXLOG_WARN(
+        "[fix] road patch subdivision: work stack full, a sub-patch left out ({} times so far; guest r1 {:08X}) - "
+        "the v00.07 crash",
+        n, guest_r1);
+  }
+}
+
+// ============================================================================
+// The 3D scene's anti-aliasing (v00.10)
+// ============================================================================
+// The game draws its 3D scene with 4x MSAA. At 1280x720 that is four times the 360's 10 MB of EDRAM, so the scene
+// renderer (sub_820BE790) splits the screen into four quadrants and the D3D runtime's predicated tiling draws the
+// whole scene once per quadrant. The GPU is meant to skip the draws outside a quadrant, from the screen extents it
+// reports for each draw; the SDK reports the whole screen (as Xenia does), so the GPU emulation - the port's
+// bottleneck - translated every scene draw 4 times (v00.09: Hoover Dam 2,000-3,000 draws a frame, Farmland up to
+// 6,800). project/tools/patch_game_fixes.py makes the renderer's sample count this setting: with one sample the
+// scene fits the EDRAM, the renderer gets one piece and takes its no-tiling branch (its SD-resolution path), and
+// every draw is translated once. The renderer reads it per view, every frame, so it changes while the game runs.
+namespace {
+std::atomic<int32_t> g_scene_msaa_samples{1};
+}  // namespace
+
+// The renderer's MSAA call (li r4,4 before sub_82130D00): the setting, kept for the rest of this view.
+extern "C" int32_t vig8_scene_msaa_begin(void) {
+  const int32_t samples = REXCVAR_GET(vig8_antialiasing) == 2 ? 4 : 1;
+  static int32_t logged = 0;  // the scene renderer runs on one guest thread
+  if (samples != logged) {
+    logged = samples;
+    REXLOG_INFO("[aa] the 3D scene: {}", samples == 4 ? "4x MSAA in 4 tiles (the original: every draw 4 times)"
+                                                      : "one sample, one pass (no tiling)");
+  }
+  g_scene_msaa_samples.store(samples, std::memory_order_relaxed);
+  return samples;
+}
+
+// The EDRAM pieces' sample count (li r6,4 before sub_82130D28): the same as the view's MSAA call.
+extern "C" int32_t vig8_scene_msaa_samples(void) {
+  return g_scene_msaa_samples.load(std::memory_order_relaxed);
+}
+
+// The no-tiling branch: clear the pieces of an earlier 4x frame (not in the original's own 4x path).
+extern "C" int32_t vig8_scene_single_pass(void) {
+  return g_scene_msaa_samples.load(std::memory_order_relaxed) == 1;
+}
+
+// ============================================================================
+// Unlock all vehicles
+// ============================================================================
+// sub_821B80F0 reads a vehicle record; bits 16-19 of the word at +196 (mask 0xF0000) are its unlock state, and zero
+// means locked. Setting them before the original runs makes every vehicle selectable.
+REX_EXTERN(sub_821B80F0) {
+  if (REXCVAR_GET(unlock_all_cars) && ctx.r3.u32) {
+    uint32_t p = ctx.r3.u32 + 196;
+    REX_STORE_U32(p, REX_LOAD_U32(p) | 0xF0000);
+  }
+  __imp__sub_821B80F0(ctx, base);
+}
diff --git a/project/ps4/vig8_ps4_menu.cpp b/project/ps4/vig8_ps4_menu.cpp
new file mode 100644
index 0000000..d345268
--- /dev/null
+++ b/project/ps4/vig8_ps4_menu.cpp
@@ -0,0 +1,1334 @@
+// vig8-ps4 - the L3+R3 quick menu and the frame counter (v00.05): settings to toggle while playing, a frame counter
+// and so on.
+//
+// MP3-PS4's quick menu (mp3/ps4/mp3_ps4_menu.cpp, the same SDK hooks) with Vigilante 8's settings: L3+R3 opens and
+// closes it, Circle closes it, the settings are saved to /data/V8A/vig8.toml on close, the game gets a neutral pad
+// until the closing buttons are released, a CPU profile can start after it closes. It draws its own console-style
+// panel with ImGui's draw lists:
+//
+//   - a side panel that slides in from the left over the dimmed game, in Lato (OFL, fonts/), baked at the sizes it is
+//     drawn at with the TV's density (the SDK's ImGui canvas is 1280x720 on a 1920x1080 output, and its renderer
+//     keeps a fixed font atlas, so a scaled font would be blurry);
+//   - tabs (L1/R1), rows of settings moved through with the D-pad: a choice changes with left/right, a switch and an
+//     action with Cross; the selected row's description below, with a "next start" tag for the settings that only
+//     apply on a restart; the buttons' hints at the bottom;
+//   - the frame counter in a corner: the game's frames a second (its VdSwap calls), with the frame times and a graph
+//     of the last 120 in the detailed mode.
+//
+// The dialog exists only while the menu is open, the counter is on, or the "saved" note shows: with no dialog the
+// presenter paints from the game's thread at once, with one it paints on the UI thread (presenter.cpp's paint modes).
+// The L3+R3 press comes from the pad driver (PS4InputDriver::TakeMenuCombo), checked at each of the game's frames.
+
+#include "vig8_ps4_menu.h"
+
+#include "vig8_ps4_achievements.h"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <deque>
+#include <filesystem>
+#include <functional>
+#include <memory>
+#include <string>
+#include <system_error>
+#include <thread>
+#include <utility>
+#include <vector>
+
+#include <imgui.h>
+
+#include <ps4_kit.h>
+#include <ps4_kit_diag.h>
+
+#include <rex/cvar.h>
+#include <rex/input/ps4/ps4_input_driver.h>
+#include <rex/logging.h>
+#include <rex/ui/imgui_dialog.h>
+#include <rex/ui/imgui_drawer.h>
+#include <rex/ui/windowed_app_context.h>
+
+#ifndef VIG8_VERSION
+#define VIG8_VERSION "ps4"
+#endif
+#ifndef VIG8_COMMIT
+#define VIG8_COMMIT "unknown"
+#endif
+
+// libkernel: 1 on a PS4 Pro (whatever mode the app runs in).
+extern "C" int32_t sceKernelHasNeoMode(void);
+// The SDK (vulkan/command_processor.cpp, v00.10): the swap post effect, live (0 none, 1 FXAA).
+extern "C" void rex_gpu_set_swap_post_effect(int32_t effect);
+
+REXCVAR_DEFINE_INT32(vig8_frame_counter, 0, "Vig8",
+                     "The frame counter: 0 = off, 1 = frames a second, 2 = with the frame times and a graph")
+    .range(0, 2);
+REXCVAR_DEFINE_INT32(vig8_frame_counter_corner, 0, "Vig8", "The frame counter's corner: 0 = top left, 1 = top right")
+    .range(0, 1);
+REXCVAR_DEFINE_BOOL(vig8_auto_profile, true, "Vig8",
+                    "Diagnostic: once a session, the first time the game stays under vig8_auto_profile_fps for "
+                    "vig8_auto_profile_s seconds, record an 8 s CPU profile of every thread (/data/V8A/profiles)");
+REXCVAR_DEFINE_INT32(vig8_auto_profile_fps, 25, "Vig8", "Diagnostic, vig8_auto_profile: under this many frames a second")
+    .range(1, 60);
+REXCVAR_DEFINE_INT32(vig8_auto_profile_s, 15, "Vig8", "Diagnostic, vig8_auto_profile: for this many seconds in a row")
+    .range(1, 600);
+
+namespace vig8::menu {
+
+namespace {
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Fonts.
+
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wc23-extensions"
+const unsigned char kLatoRegular[] = {
+#embed "fonts/Lato-Regular.ttf"
+};
+const unsigned char kLatoBlack[] = {
+#embed "fonts/Lato-Black.ttf"
+};
+#pragma clang diagnostic pop
+
+// The sizes on the 720-line canvas.
+struct Fonts {
+  ImFont* title = nullptr;    // Black 40, capitals and digits only
+  ImFont* tab = nullptr;      // Black 15
+  ImFont* row = nullptr;      // Regular 18
+  ImFont* value = nullptr;    // Black 16
+  ImFont* body = nullptr;     // Regular 14
+  ImFont* counter = nullptr;  // Black 26
+  ImFont* small = nullptr;    // Regular 12
+};
+Fonts g_fonts;
+
+// The canvas's pixels on the TV (FisicoALogico in imgui_drawer.cpp: 720 logical lines on 1080).
+constexpr float kDensity = 1080.0f / 720.0f;
+
+ImFont* AddLato(ImFontAtlas* atlas, const unsigned char* data, size_t size, float pixels, const ImWchar* ranges) {
+  ImFontConfig config;
+  config.FontDataOwnedByAtlas = false;
+  config.RasterizerDensity = kDensity;
+  config.OversampleH = 2;
+  config.OversampleV = 1;
+  return atlas->AddFontFromMemoryTTF(const_cast<unsigned char*>(data), int(size), pixels, &config, ranges);
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Frame times: the game's swaps, written on its thread, read on the UI thread.
+
+constexpr uint32_t kRing = 256;
+std::array<std::atomic<uint64_t>, kRing> g_swap_ns{};
+std::atomic<uint32_t> g_swaps{0};
+
+uint64_t NowNs() {
+  return uint64_t(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch())
+          .count());
+}
+
+struct FrameStats {
+  float fps = 0.0f;
+  float frame_ms = 0.0f;
+  float worst_ms = 0.0f;
+  std::vector<float> history;  // the last frames' times, oldest first
+};
+
+FrameStats ReadStats(size_t history) {
+  FrameStats stats;
+  const uint32_t count = g_swaps.load(std::memory_order_acquire);
+  const uint32_t have = std::min(count, kRing);
+  if (have < 2) return stats;
+  std::vector<uint64_t> times(have);
+  for (uint32_t i = 0; i < have; ++i) {
+    times[i] = g_swap_ns[(count - have + i) % kRing].load(std::memory_order_relaxed);
+  }
+  const uint64_t now = NowNs();
+  // Frames in the last second (none if the game has not swapped for a second: a load or a stall).
+  uint32_t in_second = 0;
+  double sum_ms = 0.0;
+  float worst = 0.0f;
+  for (uint32_t i = have - 1; i > 0; --i) {
+    if (times[i] < times[i - 1] || now - times[i] > 1'000'000'000ull) break;
+    const float ms = float(double(times[i] - times[i - 1]) / 1e6);
+    ++in_second;
+    sum_ms += ms;
+    worst = std::max(worst, ms);
+  }
+  if (in_second) {
+    stats.frame_ms = float(sum_ms / in_second);
+    stats.fps = stats.frame_ms > 0.0f ? 1000.0f / stats.frame_ms : 0.0f;
+    stats.worst_ms = worst;
+  }
+  const size_t n = std::min<size_t>(history, have - 1);
+  stats.history.reserve(n);
+  for (size_t i = have - n; i < have; ++i) {
+    stats.history.push_back(times[i] >= times[i - 1] ? float(double(times[i] - times[i - 1]) / 1e6) : 0.0f);
+  }
+  return stats;
+}
